{
  "name": "scorebug",
  "private": true,
  "version": "0.0.0",
  "description": "Live volleyball streaming with a graphical scoreboard overlay",
  "license": "MIT",
  "author": "Conley Chaos LLC",
  "repository": "github:jdconley/scorebug",
  "homepage": "https://scorebug.live",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test && pnpm test:tools",
    "test:tools": "pnpm --filter @scorebug/protocol build && node --test scripts/test/*.test.mjs",
    "test:container": "node scripts/test-container.mjs",
    "test:local": "node scripts/test-local.mjs",
    "test:relay": "pnpm --filter @scorebug/protocol build && pnpm --filter @scorebug/control-plane exec tsx ../../scripts/test-relay.mjs",
    "test:worker-timestamps": "pnpm --filter @scorebug/home-daemon exec tsx ../../scripts/test-worker-timestamps.mjs",
    "test:worker": "pnpm --filter @scorebug/protocol build && pnpm --filter @scorebug/home-daemon exec tsx ../../scripts/test-worker.mjs",
    "test:worker-processing": "pnpm --filter @scorebug/protocol build && pnpm --filter @scorebug/home-daemon exec tsx ../../scripts/test-worker-processing.mjs",
    "test:worker-container": "node scripts/test-worker-container.mjs",
    "test:apple": "pnpm --filter @scorebug/protocol build && node scripts/test-apple.mjs",
    "test:archive": "node scripts/test-archive.mjs",
    "test:dual-output": "node scripts/test-dual-output.mjs",
    "test:native-network": "node scripts/test-dual-output.mjs --impairment",
    "test:scoring": "pnpm --filter @scorebug/protocol build && node scripts/test-scoring.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev:api": "pnpm --filter @scorebug/protocol build && node --env-file=infra/local/.env.example apps/control-plane/node_modules/tsx/dist/cli.mjs apps/control-plane/src/index.ts",
    "local:up": "docker compose -f docker-compose.dev.yml up -d",
    "local:down": "docker compose -f docker-compose.dev.yml down",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:native-app": "node scripts/test-native-app.mjs",
    "test:native-streaming": "node scripts/test-native-app.mjs --streaming",
    "test:native-watch": "node scripts/test-native-watch.mjs",
    "test:paired-watch": "node scripts/test-paired-watch.mjs",
    "test:relay-clock": "pnpm --filter @scorebug/home-daemon exec tsx ../../scripts/test-relay-clock.mjs",
    "test:relay-origin": "pnpm --filter @scorebug/home-daemon exec tsx ../../scripts/test-relay-clock.mjs --mapping-image=scorebug/ingest:clock-v2",
    "test:encoder-payload": "node scripts/test-encoder-payload.mjs",
    "test:encoder-preparation": "node scripts/test-encoder-payload.mjs --preparation",
    "test:encoder-resolution": "node scripts/test-encoder-payload.mjs --resolution",
    "test:encoder-low-latency": "node scripts/test-encoder-payload.mjs --low-latency",
    "test:encoder-half-resolution": "node scripts/test-encoder-payload.mjs --half-resolution",
    "test:encoder-transition": "node scripts/test-encoder-payload.mjs --transition",
    "test:encoder-drained-transition": "node scripts/test-encoder-payload.mjs --drained-transition"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^6.0.3"
  }
}
