CADDY_DOMAIN=api.scorebug.live

# Generate with `openssl rand -base64 32`
PHONE_TOKEN=replace-me-phone
HOME_TOKEN=replace-me-home
INTERNAL_TOKEN=replace-me-internal

# Where pull URLs handed to home daemon point. Usually the same VPS.
INGEST_HOST=ingest.scorebug.live
INGEST_PORT=8890

# Lock this down to your scoring-PWA origin once you know where it'll be hosted.
CORS_ORIGINS=*
