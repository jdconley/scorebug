# infra/install.sh writes the real .env (mode 0600) for you. This file only
# documents the keys. Never commit the real .env.

# Topology: all-in-one runs the worker here too; split runs it at home.
SCOREBUG_TOPOLOGY=all-in-one
# One public DNS name for both the HTTPS API and the SRT relay.
CADDY_DOMAIN=scorebug.example.com
INGEST_HOST=scorebug.example.com
INGEST_PORT=8890
# Empty = all interfaces. 127.0.0.1 only for a Docker Desktop for Mac test.
INGEST_BIND=
HTTP_PORT=80
HTTPS_PORT=443
# Empty = public certificate. Use `tls internal` only for private test domains.
CADDY_TLS=

# Secrets: 32 random bytes each, hex encoded. install.sh generates them.
# SERVER_SECRET keys match credentials and SRT secrets; it never leaves the server.
SERVER_SECRET=
HOME_TOKEN=
RELAY_API_PASSWORD=

# Worker identity. Broadcasts from the phone go to this worker and output.
WORKER_ID=local-worker
OUTPUT_ID=local-output
# All-in-one only: the full YouTube RTMPS URL including the stream key.
OUTPUT_URL='rtmps://a.rtmp.youtube.com/live2/xxxx-xxxx-xxxx-xxxx-xxxx'
VIDEO_PROFILE=720p30

SCOREBUG_RELEASE=local
# Pin this to a reviewed image digest for a production release.
CADDY_IMAGE=caddy:2-alpine
# Native apps do not need browser CORS access.
CORS_ORIGINS=https://localhost.invalid
LOG_LEVEL=info
