CADDY_DOMAIN=api.example.com
INGEST_HOST=ingest.example.com
INGEST_PORT=8890

# Generate each independently with: openssl rand -hex 32
# Empty values deliberately prevent startup until configured.
PHONE_TOKEN=
HOME_TOKEN=
INTERNAL_TOKEN=
RELAY_API_PASSWORD=

# Set to the checked-out revision when building a release.
SCOREBUG_RELEASE=local
# Pin this to a reviewed image digest for a production release.
CADDY_IMAGE=caddy:2-alpine
# Native scoring does not require browser CORS access.
CORS_ORIGINS=https://localhost.invalid
