# Public, local-only test values. Never use these on an exposed server.
SERVER_SECRET=qa-server-secret-not-production
HOME_TOKEN=qa-home-token-not-production
HOST=127.0.0.1
PORT=18787
INGEST_HOST=127.0.0.1
INGEST_PORT=18890
# Optional paired native publisher endpoint; worker readers keep the address above.
# Use raw IPv6 (for example ::1), never a URL or bracketed literal. Port: 1..65535.
# INGEST_PUBLISH_HOST=127.0.0.1
# INGEST_PUBLISH_PORT=19990
LOG_LEVEL=info
# Base URL in phone setup and match invite links.
PUBLIC_URL=http://127.0.0.1:18787
DATABASE_PATH=artifacts/qa/development/scorebug.sqlite
RELAY_API_URL=http://127.0.0.1:19997
RELAY_API_USERNAME=qa-admin
RELAY_API_PASSWORD=qa-admin-not-production
