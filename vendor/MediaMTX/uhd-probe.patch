@@ -0,0 +1,45 @@
+package srt
+
+import (
+	"github.com/stretchr/testify/require"
+	"testing"
+	"time"
+)
+
+func probeV4Message(campaign, stage uint32, id byte, sequence uint64, rate uint32) []byte {
+	b := probeV3Message(campaign, stage, id, sequence, rate)
+	for i := 0; i < 7; i++ {
+		b[i*188+11] = '4'
+	}
+	return b
+}
+
+func TestProbeReaderV4BoundsAndVersionIsolation(t *testing.T) {
+	now := func() time.Time { return time.Unix(10, 0) }
+	r := newProbeReader(nil, now)
+	probeV3Feed(t, r, probeV4Message(1, 1, 1, 0, 48000000))
+	require.Empty(t, r.snapshot().InvalidReason)
+	require.Equal(t, "mpegts-null-probe-v4", r.snapshot().Convention)
+	// The last complete message fits; a partial message beyond the budget does not.
+	cap := uint64(64*1024*1024/1316) * 1316
+	r.messages = cap/1316 - 1
+	r.campaignBytes = cap - 1316
+	r.totalBytes = cap - 1316
+	probeV3Feed(t, r, probeV4Message(1, 1, 1, r.messages, 48000000))
+	require.Empty(t, r.snapshot().InvalidReason)
+	probeV3Feed(t, r, probeV4Message(1, 1, 1, r.messages, 48000000)[:188])
+	require.Equal(t, "byteLimit", r.snapshot().InvalidReason)
+	// Restart preserves total, resets campaign budget, and cannot switch protocol.
+	r = newProbeReader(nil, now)
+	probeV3Feed(t, r, probeV4Message(1, 1, 1, 0, 48000000))
+	probeV3Feed(t, r, probeV4Message(2, 1, 2, 0, 48000000))
+	require.Equal(t, "2632", r.snapshot().TotalDeliveredPayloadBytes)
+	require.Equal(t, "1316", r.snapshot().CampaignDeliveredPayloadBytes)
+	probeV3Feed(t, r, probeV3Message(3, 1, 3, 0, 12000000))
+	require.Equal(t, "scope", r.snapshot().InvalidReason)
+	for _, b := range [][]byte{probeV4Message(1, 1, 1, 0, 48000001), probeV4Message(0, 1, 1, 0, 48000000), probeV3Message(1, 1, 1, 0, 48000000)} {
+		r = newProbeReader(nil, now)
+		probeV3Feed(t, r, b)
+		require.Equal(t, "shape", r.snapshot().InvalidReason)
+	}
+}
