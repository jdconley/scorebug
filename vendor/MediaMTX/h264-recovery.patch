+package mpegts
+
+import (
+	"github.com/bluenviron/mediacommon/v2/pkg/bits"
+	"github.com/bluenviron/mediacommon/v2/pkg/codecs/h264"
+)
+
+// Validate the bounded parameter/slice prefix needed to associate a recovery IDR
+// with this AU's SPS. The upstream remuxer supplies one current SPS/PPS per IDR.
+// This is not full PPS, macroblock, or pixel-decoder validation.
+func h264RecoveryPrefixes(au [][]byte) bool {
+	var sps *h264.SPS
+	var pps []byte
+	for _, nal := range au {
+		switch h264.NALUType(nal[0] & 0x1f) {
+		case h264.NALUTypeSPS:
+			if sps != nil {
+				return false
+			}
+			sps = &h264.SPS{}
+			if sps.Unmarshal(nal) != nil || sps.ID > 31 || sps.Log2MaxFrameNumMinus4 > 12 || sps.Log2MaxPicOrderCntLsbMinus4 > 12 {
+				return false
+			}
+		case h264.NALUTypePPS:
+			if pps != nil {
+				return false
+			}
+			pps = nal
+		}
+	}
+	if sps == nil || len(pps) < 2 {
+		return false
+	}
+	body := h264RecoveryPrefix(pps)
+	pos := 0
+	ppsID, err := bits.ReadGolombUnsigned(body, &pos)
+	if err != nil || ppsID > 255 {
+		return false
+	}
+	spsID, err := bits.ReadGolombUnsigned(body, &pos)
+	if err != nil || spsID != sps.ID {
+		return false
+	}
+	_, err = bits.ReadFlag(body, &pos)
+	if err != nil {
+		return false
+	} // entropy_coding_mode_flag
+	bottomOrder, err := bits.ReadFlag(body, &pos)
+	if err != nil {
+		return false
+	}
+	found := false
+	for _, nal := range au {
+		if h264.NALUType(nal[0]&0x1f) != h264.NALUTypeIDR {
+			continue
+		}
+		found = true
+		if !h264RecoverySlicePrefix(nal, sps, ppsID, bottomOrder) {
+			return false
+		}
+	}
+	return found
+}
+
+func h264RecoveryPrefix(nal []byte) []byte {
+	// No unbounded slice copy just to inspect a small fixed/Exp-Golomb header.
+	return h264.EmulationPreventionRemove(nal[1:min(len(nal), 129)])
+}
+
+func h264RecoverySlicePrefix(nal []byte, sps *h264.SPS, ppsID uint32, bottomOrder bool) bool {
+	if len(nal) < 2 || nal[0]&0x60 == 0 {
+		return false
+	}
+	body := h264RecoveryPrefix(nal)
+	pos := 0
+	_, err := bits.ReadGolombUnsigned(body, &pos)
+	if err != nil {
+		return false
+	} // first_mb_in_slice
+	sliceType, err := bits.ReadGolombUnsigned(body, &pos)
+	if err != nil || sliceType > 9 || (sliceType%5 != 2 && sliceType%5 != 4) {
+		return false
+	}
+	usedPPS, err := bits.ReadGolombUnsigned(body, &pos)
+	if err != nil || usedPPS != ppsID {
+		return false
+	}
+	if sps.SeparateColourPlaneFlag {
+		plane, readErr := bits.ReadBits(body, &pos, 2)
+		if readErr != nil || plane > 2 {
+			return false
+		}
+	}
+	frameNum, err := bits.ReadBits(body, &pos, int(sps.Log2MaxFrameNumMinus4+4))
+	if err != nil || frameNum != 0 {
+		return false
+	} // IDR frame_num is always zero.
+	field := false
+	if !sps.FrameMbsOnlyFlag {
+		field, err = bits.ReadFlag(body, &pos)
+		if err != nil {
+			return false
+		}
+		if field {
+			_, err = bits.ReadFlag(body, &pos)
+			if err != nil {
+				return false
+			}
+		}
+	}
+	idrID, err := bits.ReadGolombUnsigned(body, &pos)
+	if err != nil || idrID > 65535 {
+		return false
+	}
+	if sps.PicOrderCntType == 0 {
+		_, err = bits.ReadBits(body, &pos, int(sps.Log2MaxPicOrderCntLsbMinus4+4))
+		if err != nil {
+			return false
+		}
+		if bottomOrder && !field {
+			_, err = bits.ReadGolombSigned(body, &pos)
+			if err != nil {
+				return false
+			}
+		}
+	} else if sps.PicOrderCntType == 1 && !sps.DeltaPicOrderAlwaysZeroFlag {
+		_, err = bits.ReadGolombSigned(body, &pos)
+		if err != nil {
+			return false
+		}
+		if bottomOrder && !field {
+			_, err = bits.ReadGolombSigned(body, &pos)
+			if err != nil {
+				return false
+			}
+		}
+	}
+	return true
+}
