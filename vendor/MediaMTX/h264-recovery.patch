+func TestH264RecoveryInitialAcquisitionAndMalformedHeaders(t *testing.T) {
+	var h h264RecoveringDTS
+	now := time.Unix(100, 0)
+	_, emit, err := h.extract(recoveryAU(t, 3, false), 9000, now)
+	require.NoError(t, err)
+	require.False(t, emit)
+	dts, emit, err := h.extract(recoveryAU(t, 0, true), 12000, now)
+	require.NoError(t, err)
+	require.True(t, emit)
+	require.EqualValues(t, 12000, dts)
+	for _, bad := range [][][]byte{{{}}, {{0xe5, 1}}, {{0x67, 0}, {0x68, 1}, {0x65, 1}}} {
+		_, emit, err = h.extract(bad, 15000, now)
+		require.NoError(t, err)
+		require.False(t, emit)
+	}
+	missingPPS := recoveryAU(t, 0, true)
+	missingPPS = append(missingPPS[:1], missingPPS[2:]...)
+	_, emit, err = h.extract(missingPPS, 18000, now)
+	require.NoError(t, err)
+	require.False(t, emit)
+	dts, emit, err = h.extract(recoveryAU(t, 0, true), 21000, now)
+	require.NoError(t, err)
+	require.True(t, emit)
+	require.EqualValues(t, 21000, dts)
+}
