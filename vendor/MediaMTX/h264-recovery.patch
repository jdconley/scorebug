+func TestH264RecoveryRejectsMalformedAndMismatchedPrefixes(t *testing.T) {
+	for _, name := range []string{"truncated PPS", "wrong SPS ID", "wrong PPS ID", "POC2 short IDR", "interlaced short IDR", "IDR with P slice"} {
+		t.Run(name, func(t *testing.T) {
+			var h h264RecoveringDTS
+			now := time.Unix(100, 0)
+			primeRecovery(t, &h, now)
+			au := recoveryAU(t, 0, true)
+			switch name {
+			case "truncated PPS":
+				au[1] = []byte{0x68, 0}
+			case "wrong SPS ID":
+				au[1] = []byte{0x68, 0xae, 0x3c, 0x80}
+			case "wrong PPS ID":
+				au[1] = []byte{0x68, 0x5e, 0x3c, 0x80}
+			case "POC2 short IDR":
+				au[0] = test.FormatH264.SPS
+				au[2] = []byte{0x65}
+			case "interlaced short IDR":
+				au[0] = recoveryInterlacedSPS(t)
+				au[2] = []byte{0x65}
+			case "IDR with P slice":
+				au[2] = recoveryAU(t, 0, false)[0]
+				au[2][0] = 0x65
+			}
+			_, emit, err := h.extract(au, 90000, now)
+			require.NoError(t, err)
+			require.False(t, emit)
+			dts, emit, err := h.extract(recoveryAU(t, 0, true), 93000, now)
+			require.NoError(t, err)
+			require.True(t, emit)
+			require.EqualValues(t, 93000, dts)
+		})
+	}
+}
