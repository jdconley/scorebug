+func TestH264RecoveryUsesReplacementParameters(t *testing.T) {
+	var h h264RecoveringDTS
+	now := time.Unix(100, 0)
+	primeRecovery(t, &h, now)
+	// Independently parsed upstream SPS fixture: different dimensions and POC width.
+	replacement := []byte{103, 100, 0, 32, 172, 23, 42, 1, 64, 30, 104, 64, 0, 1, 194, 0, 0, 87, 228, 33}
+	var oldSPS, newSPS h264.SPS
+	require.NoError(t, oldSPS.Unmarshal(recoverySPS))
+	require.NoError(t, newSPS.Unmarshal(replacement))
+	require.Equal(t, 1920, oldSPS.Width())
+	require.Equal(t, 1080, oldSPS.Height())
+	require.Equal(t, 1280, newSPS.Width())
+	require.Equal(t, 960, newSPS.Height())
+	for n := 0; n < 4; n++ {
+		dts, emit, err := h.extract(recoveryAUWithSPS(t, n, n == 0, replacement), 90000+int64(n)*3000, now)
+		require.NoError(t, err)
+		require.True(t, emit)
+		require.Equal(t, 90000+int64(n)*3000, dts)
+	}
+	dts, emit, err := h.extract(recoveryAU(t, 0, true), 120000, now)
+	require.NoError(t, err)
+	require.True(t, emit)
+	require.EqualValues(t, 120000, dts)
+}
