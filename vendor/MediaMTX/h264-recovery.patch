+package mpegts
+
+import (
+	"fmt"
+	"time"
+
+	"github.com/bluenviron/mediacommon/v2/pkg/codecs/h264"
+)
+
+// h264RecoveringDTS keeps a transiently damaged reader attached until a fresh
+// timing-parseable IDR. It never reconstructs missing pictures or rebases PTS.
+// The bounds are checked on arriving video, not by a separate timer/goroutine.
+type h264RecoveringDTS struct {
+	extractor    *h264.DTSExtractor
+	lastDTS      int64
+	hasLastDTS   bool
+	waiting      bool
+	waitingSince time.Time
+	discarded    int
+}
+
+func (h *h264RecoveringDTS) extract(au [][]byte, pts int64, now time.Time) (int64, bool, error) {
+	valid := len(au) > 0
+	for _, nal := range au {
+		if len(nal) == 0 || nal[0]&0x80 != 0 {
+			valid = false
+			break
+		}
+	}
+	if h.extractor != nil && valid {
+		dts, err := h.extractor.Extract(au, pts)
+		if err == nil && (!h.hasLastDTS || dts >= h.lastDTS) {
+			h.lastDTS = dts
+			h.hasLastDTS = true
+			return dts, true, nil
+		}
+	}
+	if !h.waiting {
+		h.extractor = nil
+		h.waiting = true
+		h.waitingSince = now
+		h.discarded = 0
+	}
+	if now.Sub(h.waitingSince) >= 10*time.Second {
+		return 0, false, fmt.Errorf("H264 timing recovery deadline")
+	}
+	// Stream remuxing supplies current parameter sets with each IDR. Require those
+	// again after damage; never reuse a potentially obsolete SPS across resolution
+	// changes. This validates timing syntax, not complete pixel decodability.
+	// Preserve upstream initial acquisition. After damage to an established
+	// stream, validate PPS/SPS/slice association even on extractor fast paths.
+	if valid && h264.IsRandomAccess(au) && h264RecoveryParameters(au) &&
+		(!h.hasLastDTS || h264RecoveryPrefixes(au)) {
+		candidate := &h264.DTSExtractor{}
+		candidate.Initialize()
+		dts, err := candidate.Extract(au, pts)
+		if err == nil && (!h.hasLastDTS || dts >= h.lastDTS) {
+			h.extractor = candidate
+			h.lastDTS = dts
+			h.hasLastDTS = true
+			h.waiting = false
+			h.discarded = 0
+			return dts, true, nil
+		}
+	}
+	h.discarded++
+	if h.discarded >= 300 {
+		return 0, false, fmt.Errorf("H264 timing recovery discard limit")
+	}
+	return 0, false, nil
+}
+
+func h264RecoveryParameters(au [][]byte) bool {
+	hasSPS, hasPPS := false, false
+	for _, nal := range au {
+		switch h264.NALUType(nal[0] & 0x1f) {
+		case h264.NALUTypeSPS:
+			var sps h264.SPS
+			if sps.Unmarshal(nal) != nil {
+				return false
+			}
+			hasSPS = true
+		case h264.NALUTypePPS:
+			if len(nal) < 2 {
+				return false
+			}
+			hasPPS = true
+		}
+	}
+	return hasSPS && hasPPS
+}
