+package mpegts
+
+import (
+	"github.com/bluenviron/mediacommon/v2/pkg/bits"
+	"github.com/bluenviron/mediacommon/v2/pkg/codecs/h264"
+	"github.com/bluenviron/mediamtx/internal/test"
+	"github.com/stretchr/testify/require"
+	"testing"
+	"time"
+)
+
+// Syntax-only access units exercise the real timing parser, not pixel decoding.
+// SPS from mediacommon's MIT-licensed DTS-extractor fixture (with timing info).
+var recoverySPS = []byte{0x67, 0x64, 0x00, 0x28, 0xac, 0xd9, 0x40, 0x78, 0x02, 0x27, 0xe5, 0x84, 0, 0, 3, 0, 4, 0, 0, 3, 0, 0xf0, 0x3c, 0x60, 0xc6, 0x58}
+
+func recoveryAU(t *testing.T, n int, idr bool) [][]byte {
+	return recoveryAUWithSPS(t, n, idr, recoverySPS)
+}
+func recoveryAUWithSPS(t *testing.T, n int, idr bool, parameters []byte) [][]byte {
+	t.Helper()
+	var sps h264.SPS
+	require.NoError(t, sps.Unmarshal(parameters))
+	require.Contains(t, []uint32{0, 2}, sps.PicOrderCntType)
+	buf := make([]byte, 32)
+	pos := 0
+	// first_mb=0, legal I slice_type=2 for IDR (P=0 otherwise), PPS ID=0.
+	if idr {
+		bits.WriteBitsUnsafe(buf, &pos, 23, 5)
+	} else {
+		bits.WriteBitsUnsafe(buf, &pos, 7, 3)
+	}
+	bits.WriteBitsUnsafe(buf, &pos, uint64(n%16), int(sps.Log2MaxFrameNumMinus4+4))
+	if !sps.FrameMbsOnlyFlag {
+		bits.WriteBitsUnsafe(buf, &pos, 0, 1)
+	}
+	if idr {
+		bits.WriteBitsUnsafe(buf, &pos, 1, 1)
+	}
+	if sps.PicOrderCntType == 0 {
+		bits.WriteBitsUnsafe(buf, &pos, uint64(n*2), int(sps.Log2MaxPicOrderCntLsbMinus4+4))
+	}
+	bits.WriteBitsUnsafe(buf, &pos, 1, 1)
+	typ := byte(0x41)
+	if idr {
+		typ = 0x65
+	}
+	nal := append([]byte{typ}, buf[:(pos+7)/8]...)
+	if idr {
+		return [][]byte{parameters, {0x68, 0xee, 0x3c, 0x80}, nal}
+	}
+	return [][]byte{nal}
+}
+func TestH264LossReproducesTerminalExtractorError(t *testing.T) {
+	var complete h264.DTSExtractor
+	complete.Initialize()
+	for n := 0; n <= 40; n++ {
+		got, err := complete.Extract(recoveryAU(t, n, n == 0), int64(n)*3000)
+		require.NoError(t, err)
+		require.Equal(t, int64(n)*3000, got)
+	}
+	var damaged h264.DTSExtractor
+	damaged.Initialize()
+	for n := 0; n < 7; n++ {
+		_, err := damaged.Extract(recoveryAU(t, n, n == 0), int64(n)*3000)
+		require.NoError(t, err)
+	}
+	_, err := damaged.Extract(recoveryAU(t, 22, false), 66000)
+	require.ErrorContains(t, err, "too many reordered frames")
+	t.Logf("Controlled loss of pictures 7–21 reproduces: %v", err)
+}
+
+func primeRecovery(t *testing.T, h *h264RecoveringDTS, now time.Time) {
+	t.Helper()
+	for n := 0; n < 7; n++ {
+		dts, emit, err := h.extract(recoveryAU(t, n, n == 0), int64(n)*3000, now)
+		require.NoError(t, err)
+		require.True(t, emit)
+		require.Equal(t, int64(n)*3000, dts)
+	}
+	_, emit, err := h.extract(recoveryAU(t, 22, false), 66000, now)
+	require.NoError(t, err)
+	require.False(t, emit)
+}
+
+func TestH264RecoveryRequiresRandomAccessAndPreservesClock(t *testing.T) {
+	var h h264RecoveringDTS
+	now := time.Unix(100, 0)
+	primeRecovery(t, &h, now)
+	_, emit, err := h.extract(recoveryAU(t, 23, false), 69000, now)
+	require.NoError(t, err)
+	require.False(t, emit)
+	// A regressed IDR is never used to rebase the source timeline.
+	_, emit, err = h.extract(recoveryAU(t, 0, true), 9000, now)
+	require.NoError(t, err)
+	require.False(t, emit)
+	dts, emit, err := h.extract(recoveryAU(t, 0, true), 90000, now.Add(time.Second))
+	require.NoError(t, err)
+	require.True(t, emit)
+	require.EqualValues(t, 90000, dts)
+	dts, emit, err = h.extract(recoveryAU(t, 1, false), 93000, now.Add(time.Second))
+	require.NoError(t, err)
+	require.True(t, emit)
+	require.EqualValues(t, 93000, dts)
+}
+
+func TestH264RecoveryRejectsDamagedCandidateAndKeepsOriginalDeadline(t *testing.T) {
+	var h h264RecoveringDTS
+	now := time.Unix(100, 0)
+	primeRecovery(t, &h, now)
+	for _, bad := range [][][]byte{nil, {nil}, {{0x65}}, {{0x67, 0}, {0x68, 1}, {0x65, 1}}, recoveryAU(t, 0, true)[1:]} {
+		_, emit, err := h.extract(bad, 90000, now.Add(9*time.Second))
+		require.NoError(t, err)
+		require.False(t, emit)
+	}
+	_, emit, err := h.extract(recoveryAU(t, 0, true), 93000, now.Add(10*time.Second))
+	require.ErrorContains(t, err, "H264 timing recovery deadline")
+	require.False(t, emit)
+}
+
+func TestH264RecoveryBoundsDiscardCount(t *testing.T) {
+	var h h264RecoveringDTS
+	now := time.Unix(100, 0)
+	primeRecovery(t, &h, now)
+	for n := 1; n < 299; n++ {
+		_, emit, err := h.extract(recoveryAU(t, 23, false), 69000, now)
+		require.NoError(t, err)
+		require.False(t, emit)
+	}
+	_, emit, err := h.extract(recoveryAU(t, 23, false), 69000, now)
+	require.ErrorContains(t, err, "H264 timing recovery discard limit")
+	require.False(t, emit)
+}
+
+func TestH264RecoveryPreservesHealthyReorderedFrames(t *testing.T) {
+	// Upstream's with-timing-info B-frame fixture; compare every original DTS.
+	aus := [][][]byte{
+		{recoverySPS, {0x68, 0xee, 0x3c, 0x80}, {0x65, 0x88, 0x84, 0, 0x33, 0xff}},
+		{{0x41, 0x9a, 0x21, 0x6c, 0x45, 0xff}},
+		{{0x41, 0x9a, 0x42, 0x3c, 0x21, 0x93}},
+		{{0x41, 0x9a, 0x63, 0x49, 0xe1, 0x0f}},
+		{{0x41, 0x9a, 0x86, 0x49, 0xe1, 0x0f}},
+		{{0x41, 0x9e, 0xa5, 0x42, 0x7f, 0xf9}},
+		{{0x01, 0x9e, 0xc4, 0x69, 0x13, 0xff}},
+		{{0x41, 0x9a, 0xc8, 0x4b, 0xa8, 0x42}},
+	}
+	pts := []int64{0, 3000, 6000, 9000, 18000, 15000, 12000, 24000}
+	expected := []int64{0, 3000, 6000, 9000, 9090, 12045, 12135, 15101}
+	var h h264RecoveringDTS
+	for i, au := range aus {
+		dts, emit, err := h.extract(au, 56890+pts[i], time.Unix(100, 0))
+		require.NoError(t, err)
+		require.True(t, emit)
+		require.Equal(t, 56890+expected[i], dts)
+	}
+}
