+func TestH264RecoveryRequiresRandomAccessAndPreservesClock(t *testing.T) {
+	var h h264RecoveringDTS
+	now := time.Unix(100, 0)
+	primeRecovery(t, &h, now)
+	_, emit, err := h.extract(recoveryAU(t, 23, false), 69000, now)
+	require.NoError(t, err)
+	require.False(t, emit)
+	// A regressed IDR is never used to rebase the source timeline.
+	_, emit, err = h.extract(recoveryAU(t, 0, true), 9000, now)
+	require.NoError(t, err)
+	require.False(t, emit)
+	dts, emit, err := h.extract(recoveryAU(t, 0, true), 90000, now.Add(time.Second))
+	require.NoError(t, err)
+	require.True(t, emit)
+	require.EqualValues(t, 90000, dts)
+	dts, emit, err = h.extract(recoveryAU(t, 1, false), 93000, now.Add(time.Second))
+	require.NoError(t, err)
+	require.True(t, emit)
+	require.EqualValues(t, 93000, dts)
