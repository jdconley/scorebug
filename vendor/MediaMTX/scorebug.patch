diff --git a/internal/protocols/mpegts/to_stream_clock_origin_test.go b/internal/protocols/mpegts/to_stream_clock_origin_test.go
new file mode 100644
index 0000000..7bb785b
--- /dev/null
+++ b/internal/protocols/mpegts/to_stream_clock_origin_test.go
@@ -0,0 +1,138 @@
+package mpegts
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"testing"
+	"time"
+
+	"github.com/bluenviron/gortsplib/v5/pkg/description"
+	"github.com/bluenviron/mediacommon/v2/pkg/codecs/mpeg4audio"
+	mcmpegts "github.com/bluenviron/mediacommon/v2/pkg/formats/mpegts"
+	"github.com/bluenviron/mediacommon/v2/pkg/formats/mpegts/codecs"
+	"github.com/stretchr/testify/require"
+
+	"github.com/bluenviron/mediamtx/internal/stream"
+	"github.com/bluenviron/mediamtx/internal/test"
+	"github.com/bluenviron/mediamtx/internal/unit"
+)
+
+// Exercise real TS demux callbacks and delivered stream units, using the unmodified
+// mediacommon decoder as the oracle, including audio selecting the shared origin.
+func TestToStreamClockOrigin(t *testing.T) {
+	for _, origin := range []int64{0, 9000, (1 << 33) - 2000} {
+		for _, audioFirst := range []bool{false, true} {
+			for _, observed := range []bool{false, true} {
+				t.Run(fmt.Sprintf("origin_%d/audio_first_%v/observed_%v", origin, audioFirst, observed), func(t *testing.T) {
+					var buf bytes.Buffer
+					video := &mcmpegts.Track{Codec: &codecs.H264{}}
+					audio := &mcmpegts.Track{Codec: &codecs.MPEG4Audio{Config: mpeg4audio.AudioSpecificConfig{
+						Type: 2, SampleRate: 48000, ChannelConfig: 2,
+					}}}
+					w := &mcmpegts.Writer{W: &buf, Tracks: []*mcmpegts.Track{video, audio}}
+					require.NoError(t, w.Initialize())
+					_, err := w.WriteTables()
+					require.NoError(t, err)
+					// Backward steps and wrap are intentional. The first callback is not the minimum PTS.
+					pts := []int64{origin, (origin + 3000) & ((1 << 33) - 1), (origin + 1000) & ((1 << 33) - 1),
+						(origin + 6000) & ((1 << 33) - 1), (origin + 9000) & ((1 << 33) - 1)}
+					type sample struct {
+						audio bool
+						pts   int64
+					}
+					var expected []sample
+					for i, p := range pts {
+						isAudio := (i%2 == 0) == audioFirst
+						if isAudio {
+							require.NoError(t, w.WriteMPEG4Audio(audio, p, [][]byte{{1, 2, 3, 4}}))
+						} else {
+							require.NoError(t, w.WriteH264(video, p, p, [][]byte{test.FormatH264.SPS, test.FormatH264.PPS, {5, byte(i)}}))
+						}
+					}
+					// Video PES delivery can lag audio. Observe the actual callback order
+					// independently instead of assuming writer order or the lowest PTS.
+					oracle := &mcmpegts.TimeDecoder{}
+					oracle.Initialize()
+					raw := &EnhancedReader{R: bytes.NewReader(buf.Bytes())}
+					require.NoError(t, raw.Initialize())
+					var firstPTS int64
+					observe := func(p int64, isAudio bool) {
+						if len(expected) == 0 {
+							firstPTS = p
+						}
+						d := oracle.Decode(p)
+						if isAudio {
+							d = multiplyAndDivide(d, 48000, 90000)
+						}
+						expected = append(expected, sample{isAudio, d})
+					}
+					for _, track := range raw.Tracks() {
+						switch track.Codec.(type) {
+						case *codecs.H264:
+							raw.OnDataH264(track, func(p, _ int64, _ [][]byte) error { observe(p, false); return nil })
+						case *codecs.MPEG4Audio:
+							raw.OnDataMPEG4Audio(track, func(p int64, _ [][]byte) error { observe(p, true); return nil })
+						}
+					}
+					for {
+						err = raw.Read()
+						if err != nil {
+							require.ErrorIs(t, err, io.EOF)
+							break
+						}
+					}
+					require.NotEmpty(t, expected)
+					if audioFirst {
+						require.Equal(t, origin, firstPTS)
+					}
+					r := &EnhancedReader{R: bytes.NewReader(buf.Bytes())}
+					require.NoError(t, r.Initialize())
+					var sub *stream.SubStream
+					var origins []int64
+					var medias []*description.Media
+					if observed {
+						medias, err = ToStreamWithClockOrigin(r, &sub, test.NilLogger, func(p int64) { origins = append(origins, p) })
+					} else {
+						medias, err = ToStream(r, &sub, test.NilLogger)
+					}
+					require.NoError(t, err)
+					require.Empty(t, origins, "registration must not observe a timestamp")
+					s := &stream.Stream{OrigDesc: &description.Session{Medias: medias}, WriteQueueSize: 512, RTPMaxPayloadSize: 1450, Parent: test.NilLogger}
+					require.NoError(t, s.Initialize())
+					defer s.Close()
+					sub = &stream.SubStream{Stream: s}
+					require.NoError(t, sub.Initialize())
+					received := make(chan sample, 32)
+					reader := &stream.Reader{Parent: test.NilLogger}
+					for _, media := range medias {
+						isAudio := media.Type == description.MediaTypeAudio
+						reader.OnData(media, media.Formats[0], func(u *unit.Unit) error { received <- sample{isAudio, u.PTS}; return nil })
+					}
+					s.AddReader(reader)
+					defer s.RemoveReader(reader)
+					for {
+						err = r.Read()
+						if err != nil {
+							require.ErrorIs(t, err, io.EOF)
+							break
+						}
+					}
+					if observed {
+						require.Equal(t, []int64{firstPTS}, origins)
+					} else {
+						require.Empty(t, origins)
+					}
+					for _, want := range expected {
+						select {
+						case got := <-received:
+							require.Equal(t, want, got)
+						case <-time.After(time.Second):
+							t.Fatal("missing stream unit")
+						}
+					}
+				})
+			}
+		}
+	}
+}
