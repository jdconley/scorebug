+package srt
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/hex"
+	"io"
+	"strconv"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// Fixed independent wire prefix agrees with the Swift vector, with sequence zero.
+func probeTestMessage(sequence uint64) []byte {
+	prefix, _ := hex.DecodeString("471fff10534255475052423100112233445566778899aabbccddeeff01020304050607080000000000000000000f4240")
+	b := bytes.Repeat([]byte{0xff}, 1316)
+	for part := 0; part < 7; part++ {
+		at := part * 188
+		copy(b[at:], prefix)
+		binary.BigEndian.PutUint64(b[at+36:], sequence)
+		b[at+48] = byte(part)
+	}
+	return b
+}
+
+type probeChunkReader struct {
+	data       []byte
+	chunk      int
+	finalError error
+}
+
+func (r *probeChunkReader) Read(p []byte) (int, error) {
+	if len(r.data) == 0 {
+		return 0, io.EOF
+	}
+	n := min(len(p), len(r.data), r.chunk)
+	copy(p, r.data[:n])
+	r.data = r.data[n:]
+	if len(r.data) == 0 {
+		return n, r.finalError
+	}
+	return n, nil
+}
+func TestProbeReaderDeliveredIdentityAcrossReadBoundaries(t *testing.T) {
+	for _, chunk := range []int{1, 17, 187, 188, 189, 1316, 4096} {
+		t.Run(strconv.Itoa(chunk), func(t *testing.T) {
+			ordinary := bytes.Repeat([]byte{0xff}, 188)
+			copy(ordinary, []byte{0x47, 0x1f, 0xff, 0x10})
+			input := append(append(append([]byte{}, ordinary...), probeTestMessage(0)...), probeTestMessage(1)...)
+			input = append(input, ordinary...)
+			base := time.Unix(0, 0)
+			now := base
+			observer := newProbeReader(&probeChunkReader{input, chunk, io.EOF}, func() time.Time { now = now.Add(time.Millisecond); return now })
+			output, err := io.ReadAll(observer)
+			require.NoError(t, err)
+			require.Equal(t, input, output)
+			s := observer.snapshot()
+			require.NotNil(t, s)
+			require.Empty(t, s.InvalidReason)
+			require.Equal(t, "00112233-4455-6677-8899-aabbccddeeff", s.ID)
+			require.Equal(t, "72623859790382856", s.PublishingGeneration)
+			require.Equal(t, 1000000, s.BitRate)
+			require.Equal(t, "2", s.DeliveredMessages)
+			require.Equal(t, "2632", s.DeliveredPayloadBytes)
+			require.Equal(t, "2", s.NextSequence)
+			require.Equal(t, 0, s.PendingPackets)
+			require.NotEmpty(t, s.FirstDeliveredAtNanoseconds)
+			require.NotEmpty(t, s.LastDeliveredAtNanoseconds)
+			s.ID = "mutated"
+			require.NotEqual(t, s.ID, observer.snapshot().ID)
+		})
+	}
+}
+
+func TestProbeReaderRejectsMalformedAndCrossedEvidenceWithoutChangingInput(t *testing.T) {
+	tests := []struct {
+		name, reason string
+		make         func() []byte
+	}{
+		{"skipped", "sequence", func() []byte { return probeTestMessage(1) }},
+		{"duplicate", "sequence", func() []byte { return append(probeTestMessage(0), probeTestMessage(0)...) }},
+		{"ordinal", "sequence", func() []byte { b := probeTestMessage(0); b[48] = 1; return b }},
+		{"ordinalRange", "shape", func() []byte { b := probeTestMessage(0); b[48] = 7; return b }},
+		{"generation", "scope", func() []byte { b := probeTestMessage(0); b[188+35]++; return b }},
+		{"identity", "scope", func() []byte { b := probeTestMessage(0); b[188+12]++; return b }},
+		{"rate", "scope", func() []byte { b := probeTestMessage(0); b[188+47]++; return b }},
+		{"header", "shape", func() []byte { b := probeTestMessage(0); b[3] = 0x30; return b }},
+		{"tail", "shape", func() []byte { b := probeTestMessage(0); b[187] = 0; return b }},
+		{"zeroID", "shape", func() []byte { b := probeTestMessage(0); clear(b[12:28]); return b }},
+		{"zeroGeneration", "shape", func() []byte { b := probeTestMessage(0); clear(b[28:36]); return b }},
+		{"zeroRate", "shape", func() []byte { b := probeTestMessage(0); clear(b[44:48]); return b }},
+		{"excessRate", "shape", func() []byte { b := probeTestMessage(0); binary.BigEndian.PutUint32(b[44:], 2000001); return b }},
+		{"partialMessage", "truncated", func() []byte { return probeTestMessage(0)[:188] }},
+		{"partialPacket", "truncated", func() []byte { return probeTestMessage(0)[:189] }},
+		{"alignment", "alignment", func() []byte { b := append(probeTestMessage(0), probeTestMessage(1)...); b[1316] = 0; return b }},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			data := tt.make()
+			r := newProbeReader(&probeChunkReader{data, 71, io.EOF}, time.Now)
+			out, err := io.ReadAll(r)
+			require.NoError(t, err)
+			require.Equal(t, data, out)
+			s := r.snapshot()
+			require.NotNil(t, s)
+			require.Equal(t, tt.reason, s.InvalidReason)
+			before := s.DeliveredPayloadBytes
+			r.r = bytes.NewReader(probeTestMessage(0))
+			_, err = io.ReadAll(r)
+			require.NoError(t, err)
+			require.Equal(t, before, r.snapshot().DeliveredPayloadBytes)
+			require.Equal(t, tt.reason, r.snapshot().InvalidReason)
+		})
+	}
+}
+func TestProbeReaderOrdinaryNullAndMediaAreNotProbeTraffic(t *testing.T) {
+	data := bytes.Repeat([]byte{0xff}, 188)
+	copy(data, []byte{0x47, 0x1f, 0xff, 0x10})
+	media := probeTestMessage(0)
+	for at := 0; at < len(media); at += 188 {
+		media[at+1] = 1
+		media[at+2] = 0
+	}
+	data = append(data, media...)
+	r := newProbeReader(bytes.NewReader(data), time.Now)
+	out, err := io.ReadAll(r)
+	require.NoError(t, err)
+	require.Equal(t, data, out)
+	require.Nil(t, r.snapshot())
+}
+func TestProbeReaderPartialMessageAndErrorPreservation(t *testing.T) {
+	r := newProbeReader(bytes.NewReader(probeTestMessage(0)), time.Now)
+	b := make([]byte, 188)
+	n, err := r.Read(b)
+	require.Equal(t, 188, n)
+	require.NoError(t, err)
+	s := r.snapshot()
+	require.Equal(t, 1, s.PendingPackets)
+	require.Equal(t, "0", s.DeliveredMessages)
+	require.Nil(t, s.FirstDeliveredAtNanoseconds)
+	_, err = io.Copy(io.Discard, r)
+	require.NoError(t, err)
+	require.Equal(t, "1", r.snapshot().DeliveredMessages)
+	failure := io.ErrUnexpectedEOF
+	data := probeTestMessage(0)
+	r = newProbeReader(&probeChunkReader{data, 1316, failure}, time.Now)
+	b = make([]byte, 2000)
+	n, err = r.Read(b)
+	require.Equal(t, 1316, n)
+	require.ErrorIs(t, err, failure)
+	require.Equal(t, data, b[:n])
+	require.Equal(t, "1", r.snapshot().DeliveredMessages)
+	require.Empty(t, r.snapshot().InvalidReason)
+}
+func TestProbeReaderClockAndDeliveryTimes(t *testing.T) {
+	base := time.Unix(10, 0)
+	now := base
+	r := newProbeReader(bytes.NewReader(probeTestMessage(0)), func() time.Time { return now })
+	now = base.Add(2 * time.Second)
+	_, err := io.Copy(io.Discard, r)
+	require.NoError(t, err)
+	now = base.Add(3 * time.Second)
+	s := r.snapshot()
+	require.Equal(t, "2000000000", *s.FirstDeliveredAtNanoseconds)
+	require.Equal(t, "2000000000", *s.LastDeliveredAtNanoseconds)
+	require.Equal(t, "3000000000", s.ObservedAtNanoseconds)
+	*s.LastDeliveredAtNanoseconds = "mutated"
+	require.Equal(t, "2000000000", *r.snapshot().LastDeliveredAtNanoseconds)
+	now = base.Add(time.Second)
+	require.Equal(t, "clock", r.snapshot().InvalidReason)
+}
+func TestProbeReaderByteBudgetAndConcurrentSnapshots(t *testing.T) {
+	var input []byte
+	const messages = 16 * 1024 * 1024 / 1316
+	for seq := 0; seq <= messages; seq++ {
+		input = append(input, probeTestMessage(uint64(seq))...)
+	}
+	r := newProbeReader(bytes.NewReader(input), time.Now)
+	done := make(chan struct{})
+	var wg sync.WaitGroup
+	for range 4 {
+		wg.Go(func() {
+			for {
+				select {
+				case <-done:
+					return
+				default:
+					if s := r.snapshot(); s != nil {
+						s.ID = "local"
+					}
+				}
+			}
+		})
+	}
+	out, err := io.ReadAll(r)
+	close(done)
+	wg.Wait()
+	require.NoError(t, err)
+	require.Equal(t, input, out)
+	s := r.snapshot()
+	require.Equal(t, "byteLimit", s.InvalidReason)
+	require.Equal(t, strconv.Itoa(messages), s.DeliveredMessages)
+	require.Equal(t, strconv.Itoa(messages*1316), s.DeliveredPayloadBytes)
+}
