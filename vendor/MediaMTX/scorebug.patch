+			}}
+			// Even an unsuccessful read attempt must clear any previous cached descriptor.
+			c.readerSource = &defs.APIPathSource{Type: defs.APIPathSourceTypeSRTConn, ID: uuid.NewString()}
+			require.Error(t, c.runRead(&streamID{path: "relay-test"}))
+			require.Nil(t, c.readerSource)
+			require.NotContains(t, clockJSON(t, c), "scorebugReaderSource")
+			require.Nil(t, c.reader)
+			if phase != "registration" {
+				<-path.removed
+			}
+		})
+	}
+}
