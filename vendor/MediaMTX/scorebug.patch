+package srt
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/bluenviron/mediacommon/v2/pkg/codecs/mpeg4audio"
+	"github.com/bluenviron/mediacommon/v2/pkg/formats/mpegts"
+	"github.com/bluenviron/mediacommon/v2/pkg/formats/mpegts/codecs"
+	gosrt "github.com/datarhei/gosrt"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+
+	"github.com/bluenviron/mediamtx/internal/conf"
+	"github.com/bluenviron/mediamtx/internal/defs"
+	"github.com/bluenviron/mediamtx/internal/stream"
+	"github.com/bluenviron/mediamtx/internal/test"
+	"github.com/bluenviron/mediamtx/internal/unit"
+)
+
+type clockConnRequest struct{ gosrt.ConnRequest }
+
+func (clockConnRequest) RemoteAddr() net.Addr {
+	return &net.UDPAddr{IP: net.ParseIP("127.0.0.1"), Port: 9999}
+}
+
+type clockConn struct {
+	gosrt.Conn
+	data *bytes.Reader
+	stop chan struct{}
+}
+
+func (c *clockConn) Read(p []byte) (int, error) {
+	n, err := c.data.Read(p)
+	if err == io.EOF {
+		<-c.stop
+	}
+	return n, err
+}
+func (*clockConn) SetReadDeadline(time.Time) error { return nil }
+func (*clockConn) Stats(*gosrt.Statistics)         {}
+
+type clockPath struct {
+	dummyPath
+	removed chan struct{}
+}
+
+func (p *clockPath) RemovePublisher(defs.PathRemovePublisherReq) { close(p.removed) }
+
+func clockJSON(t *testing.T, c *conn) map[string]any {
+	t.Helper()
+	b, err := json.Marshal(c.apiItem())
+	require.NoError(t, err)
+	var item map[string]any
+	require.NoError(t, json.Unmarshal(b, &item))
+	return item
+}
+
+func TestConnClockOriginLifecycle(t *testing.T) {
+	for _, always := range []bool{false, true} {
+		for _, origin := range []int64{0, 9000, (1 << 33) - 2000} {
+			t.Run(fmt.Sprintf("always_%v/origin_%d", always, origin), func(t *testing.T) {
+				var buf bytes.Buffer
+				buf.Write(probeTestMessage(0))
+				audio := &mpegts.Track{Codec: &codecs.MPEG4Audio{Config: mpeg4audio.AudioSpecificConfig{Type: 2, SampleRate: 48000, ChannelConfig: 2}}}
+				video := &mpegts.Track{Codec: &codecs.H264{}}
+				w := &mpegts.Writer{W: &buf, Tracks: []*mpegts.Track{video, audio}}
+				require.NoError(t, w.Initialize())
+				_, err := w.WriteTables()
+				require.NoError(t, err)
+				require.NoError(t, w.WriteMPEG4Audio(audio, origin, [][]byte{{1, 2, 3, 4}}))
+				require.NoError(t, w.WriteH264(video, (origin+3000)&((1<<33)-1), (origin+3000)&((1<<33)-1), [][]byte{test.FormatH264.SPS, test.FormatH264.PPS, {5, 1}}))
+				require.NoError(t, w.WriteMPEG4Audio(audio, (origin+6000)&((1<<33)-1), [][]byte{{1, 2, 3, 4}}))
+				buf.Write(probeTestMessage(1))
+				transport := &clockConn{data: bytes.NewReader(buf.Bytes()), stop: make(chan struct{})}
+				defer func() {
+					select {
+					case <-transport.stop:
+					default:
+						close(transport.stop)
+					}
+				}()
+				path := &clockPath{removed: make(chan struct{})}
+				pathConf := &conf.Path{AlwaysAvailable: always}
+				added := make(chan struct{})
+				proceed := make(chan struct{})
+				delivered := make(chan struct{}, 10)
+				var strm *stream.Stream
+				var reader *stream.Reader
+				c := &conn{uuid: uuid.New(), connReq: clockConnRequest{}, state: defs.APISRTConnStateIdle,
+					readTimeout: conf.Duration(time.Second), parent: &Server{Parent: test.NilLogger}}
+				c.pathManager = &test.PathManager{AddPublisherImpl: func(req defs.PathAddPublisherReq) (*defs.PathAddPublisherRes, error) {
+					require.Same(t, pathConf, req.ConfToCompare)
+					strm = &stream.Stream{OrigDesc: req.Desc, WriteQueueSize: 512, RTPMaxPayloadSize: 1450, Parent: test.NilLogger}
+					require.NoError(t, strm.Initialize())
+					sub := &stream.SubStream{Stream: strm}
+					require.NoError(t, sub.Initialize())
+					reader = &stream.Reader{Parent: test.NilLogger}
+					for _, media := range req.Desc.Medias {
+						reader.OnData(media, media.Formats[0], func(*unit.Unit) error { delivered <- struct{}{}; return nil })
+					}
+					strm.AddReader(reader)
+					close(added)
+					<-proceed
+					return &defs.PathAddPublisherRes{Path: path, SubStream: sub}, nil
+				}}
+				done := make(chan error, 1)
+				go func() { done <- c.runPublishReader(transport, &streamID{path: "clock-test"}, pathConf) }()
+				select {
+				case <-added:
+				case <-time.After(time.Second):
+					t.Fatal("publisher not added")
+				}
+				defer func() { strm.RemoveReader(reader); strm.Close() }()
+				require.NotContains(t, clockJSON(t, c), "scorebugTransportClock", "no decoder callback yet")
+				close(proceed)
+				select {
+				case <-delivered:
+				case <-time.After(time.Second):
+					t.Fatal("missing callback")
+				}
+				require.Eventually(t, func() bool {
+					item := clockJSON(t, c)
+					p, ok := item["scorebugBandwidthProbe"].(map[string]any)
+					return ok && p["deliveredMessages"] == "2" && p["deliveredPayloadBytes"] == "2632"
+				}, time.Second, time.Millisecond)
+				snapshotProbe := c.apiItem().ScorebugBandwidthProbe
+				require.NotNil(t, snapshotProbe)
+				snapshotProbe.ID = "mutated"
+				*snapshotProbe.LastDeliveredAtNanoseconds = "mutated"
+				require.NotEqual(t, "mutated", c.apiItem().ScorebugBandwidthProbe.ID)
+				require.NotEqual(t, "mutated", *c.apiItem().ScorebugBandwidthProbe.LastDeliveredAtNanoseconds)
+				item := clockJSON(t, c)
+				if always {
+					require.NotContains(t, item, "scorebugTransportClock")
+				} else {
+					require.Equal(t, map[string]any{"convention": "mpegts-ingress-origin-90k-v1", "originPTS": fmt.Sprint(origin)}, item["scorebugTransportClock"])
+					require.Equal(t, c.uuid.String(), item["id"])
+					require.Equal(t, "publish", item["state"])
+					require.Equal(t, "clock-test", item["path"])
+					// Returned API objects are independent snapshots, even if a caller mutates one.
+					snapshot := c.apiItem()
+					snapshot.ScorebugTransportClock.OriginPTS = "mutated"
+					require.Equal(t, fmt.Sprint(origin), c.apiItem().ScorebugTransportClock.OriginPTS)
+					for _, state := range []defs.APISRTConnState{defs.APISRTConnStateRead, defs.APISRTConnStateIdle} {
+						c.mutex.Lock()
+						c.state = state
+						c.mutex.Unlock()
+						require.NotContains(t, clockJSON(t, c), "scorebugTransportClock")
+						require.NotContains(t, clockJSON(t, c), "scorebugBandwidthProbe")
+					}
+					c.mutex.Lock()
+					c.state = defs.APISRTConnStatePublish
+					c.mutex.Unlock()
+					other := &conn{uuid: uuid.New(), connReq: clockConnRequest{}, state: defs.APISRTConnStatePublish, pathName: "clock-test"}
+					require.NotContains(t, clockJSON(t, other), "scorebugTransportClock", "new publication must not inherit origin")
+					require.NotContains(t, clockJSON(t, other), "scorebugBandwidthProbe")
+				}
+				// Concurrent snapshots race with teardown and mutate only their own copy.
+				var wg sync.WaitGroup
+				for range 8 {
+					wg.Go(func() {
+						for range 100 {
+							v := c.apiItem()
+							if v.ScorebugBandwidthProbe != nil {
+								v.ScorebugBandwidthProbe.ID = "local"
+							}
+							if v.ScorebugTransportClock != nil {
+								v.ScorebugTransportClock.OriginPTS = "local"
+							}
+						}
+					})
+				}
+				close(transport.stop)
+				select {
+				case err := <-done:
+					require.ErrorIs(t, err, io.EOF)
+				case <-time.After(time.Second):
+					t.Fatal("reader did not exit")
+				}
+				wg.Wait()
+				<-path.removed
+				require.NotContains(t, clockJSON(t, c), "scorebugTransportClock", "reader teardown clears origin")
+				require.NotContains(t, clockJSON(t, c), "scorebugBandwidthProbe", "publisher teardown clears probe")
+			})
+		}
+	}
+}
