+func TestConnReaderSourceFailedStartup(t *testing.T) {
+	for _, phase := range []string{"registration", "passphrase", "accept", "format"} {
+		t.Run(phase, func(t *testing.T) {
+			path := &readerSourcePath{conf: &conf.Path{}, removed: make(chan struct{})}
+			transport := &readerSourceTransport{}
+			request := &readerSourceRequest{transport: transport}
+			if phase == "passphrase" {
+				path.conf.SRTReadPassphrase = "reader-password"
+			}
+			if phase == "accept" {
+				request.acceptErr = fmt.Errorf("accept failed")
