+func recoveryInterlacedSPS(t *testing.T) []byte {
+	t.Helper()
+	buf := make([]byte, 64)
+	pos := 0
+	ue := func(value uint32) {
+		n := 0
+		for v := value + 1; v > 1; v >>= 1 {
+			n++
+		}
+		bits.WriteBitsUnsafe(buf, &pos, 0, n)
+		bits.WriteBitsUnsafe(buf, &pos, uint64(value+1), n+1)
+	}
+	bits.WriteBitsUnsafe(buf, &pos, 66, 8)
+	bits.WriteBitsUnsafe(buf, &pos, 0, 8)
+	bits.WriteBitsUnsafe(buf, &pos, 40, 8)
+	ue(0)
+	ue(0)
+	ue(2)
+	ue(1) // SPS ID, frame_num width, POC type 2, ref frames.
+	bits.WriteBitsUnsafe(buf, &pos, 0, 1)
+	ue(59)
+	ue(16)
+	bits.WriteBitsUnsafe(buf, &pos, 0, 1)
+	bits.WriteBitsUnsafe(buf, &pos, 0, 1) // frame and MBAFF flags.
+	bits.WriteBitsUnsafe(buf, &pos, 1, 1)
+	bits.WriteBitsUnsafe(buf, &pos, 0, 1)
+	bits.WriteBitsUnsafe(buf, &pos, 0, 1)
+	bits.WriteBitsUnsafe(buf, &pos, 1, 1)
+	nal := append([]byte{0x67}, buf[:(pos+7)/8]...)
+	var sps h264.SPS
+	require.NoError(t, sps.Unmarshal(nal))
+	require.False(t, sps.FrameMbsOnlyFlag)
+	require.EqualValues(t, 2, sps.PicOrderCntType)
+	return nal
+}
