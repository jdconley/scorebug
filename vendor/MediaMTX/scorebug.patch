+package srt
+
+import (
+	"bytes"
+	"encoding/binary"
+	"io"
+	"strconv"
+	"sync"
+	"time"
+
+	"github.com/bluenviron/mediamtx/internal/defs"
+	"github.com/google/uuid"
+)
+
+// probeReader observes delivered TS bytes without changing demux input or errors.
+// It owns one partial packet and one attempt; invalid evidence never stops media.
+type probeReader struct {
+	r           io.Reader
+	now         func() time.Time
+	origin      time.Time
+	mutex       sync.Mutex
+	partial     [188]byte
+	used        int
+	seen        bool
+	id          uuid.UUID
+	generation  uint64
+	rate        uint32
+	messages    uint64
+	pending     int
+	first, last *int64
+	clock       int64
+	invalid     string
+}
+
+func newProbeReader(r io.Reader, now func() time.Time) *probeReader {
+	return &probeReader{r: r, now: now, origin: now()}
+}
+func (r *probeReader) fail(reason string) {
+	if r.invalid == "" {
+		r.invalid = reason
+	}
+}
+func (r *probeReader) stamp() int64 {
+	at := r.now().Sub(r.origin).Nanoseconds()
+	if at < r.clock || at < 0 {
+		r.fail("clock")
+		return r.clock
+	}
+	r.clock = at
+	return at
+}
+func (r *probeReader) Read(p []byte) (int, error) {
+	n, err := r.r.Read(p)
+	r.mutex.Lock()
+	defer r.mutex.Unlock()
+	at := r.stamp()
+	if r.invalid == "" {
+		data := p[:n]
+		for len(data) > 0 {
+			if r.used == 0 && len(data) >= 188 {
+				r.packet(data[:188], at)
+				data = data[188:]
+			} else {
+				size := copy(r.partial[r.used:], data)
+				r.used += size
+				data = data[size:]
+				if r.used == 188 {
+					r.packet(r.partial[:], at)
+					r.used = 0
+				}
+			}
+			if r.invalid != "" {
+				break
+			}
+		}
+		if err != nil && (r.used != 0 || r.pending != 0) {
+			r.fail("truncated")
+		}
+	}
+	return n, err
+}
+func (r *probeReader) packet(p []byte, at int64) {
+	if p[0] != 0x47 {
+		r.fail("alignment")
+		return
+	}
+	// Other TS packets, including ordinary anonymous null packets, are not probes.
+	if p[1]&0x1f != 0x1f || p[2] != 0xff || !bytes.Equal(p[4:12], []byte("SBUGPRB1")) {
+		return
+	}
+	r.seen = true
+	if !bytes.Equal(p[:4], []byte{0x47, 0x1f, 0xff, 0x10}) {
+		r.fail("shape")
+		return
+	}
+	for _, v := range p[49:] {
+		if v != 0xff {
+			r.fail("shape")
+			return
+		}
+	}
+	id := uuid.UUID(p[12:28])
+	generation := binary.BigEndian.Uint64(p[28:36])
+	sequence := binary.BigEndian.Uint64(p[36:44])
+	rate := binary.BigEndian.Uint32(p[44:48])
+	if id == uuid.Nil || generation == 0 || rate == 0 || rate > 2000000 || p[48] > 6 {
+		r.fail("shape")
+		return
+	}
+	if r.id == uuid.Nil {
+		r.id = id
+		r.generation = generation
+		r.rate = rate
+	} else if r.id != id || r.generation != generation || r.rate != rate {
+		r.fail("scope")
+		return
+	}
+	if sequence != r.messages || int(p[48]) != r.pending {
+		r.fail("sequence")
+		return
+	}
+	if (r.messages+1)*1316 > 16*1024*1024 {
+		r.fail("byteLimit")
+		return
+	}
+	r.pending++
+	if r.pending == 7 {
+		r.pending = 0
+		r.messages++
+		if r.first == nil {
+			first := at
+			r.first = &first
+		}
+		last := at
+		r.last = &last
+	}
+}
+func (r *probeReader) snapshot() *defs.APISRTBandwidthProbe {
+	r.mutex.Lock()
+	defer r.mutex.Unlock()
+	if !r.seen {
+		return nil
+	}
+	at := r.stamp()
+	value := &defs.APISRTBandwidthProbe{Convention: "mpegts-null-probe-v1", ID: r.id.String(),
+		PublishingGeneration: strconv.FormatUint(r.generation, 10), BitRate: int(r.rate),
+		DeliveredMessages: strconv.FormatUint(r.messages, 10), DeliveredPayloadBytes: strconv.FormatUint(r.messages*1316, 10),
+		NextSequence: strconv.FormatUint(r.messages, 10), PendingPackets: r.pending,
+		ObservedAtNanoseconds: strconv.FormatInt(at, 10), InvalidReason: r.invalid}
+	if r.first != nil {
+		s := strconv.FormatInt(*r.first, 10)
+		value.FirstDeliveredAtNanoseconds = &s
+	}
+	if r.last != nil {
+		s := strconv.FormatInt(*r.last, 10)
+		value.LastDeliveredAtNanoseconds = &s
+	}
+	return value
+}
