+			c := &conn{ctx: context.Background(), uuid: uuid.New(), connReq: request, state: defs.APISRTConnStateIdle, udpMaxPayloadSize: 1472, parent: &Server{Parent: test.NilLogger}}
+			c.pathManager = &test.PathManager{AddReaderImpl: func(defs.PathAddReaderReq) (*defs.PathAddReaderRes, error) {
+				if phase == "registration" {
