diff --git a/internal/core/path_reader_source_test.go b/internal/core/path_reader_source_test.go
new file mode 100644
index 0000000..daa2aec
--- /dev/null
+++ b/internal/core/path_reader_source_test.go
@@ -0,0 +1,105 @@
+package core
+
+import (
+	"testing"
+
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+
+	"github.com/bluenviron/mediamtx/internal/conf"
+	"github.com/bluenviron/mediamtx/internal/defs"
+	"github.com/bluenviron/mediamtx/internal/logger"
+	"github.com/bluenviron/mediamtx/internal/stream"
+	"github.com/bluenviron/mediamtx/internal/test"
+)
+
+type readerSourceTestSource struct {
+	logger.Writer
+	desc *defs.APIPathSource
+}
+
+func (s *readerSourceTestSource) APISourceDescribe() *defs.APIPathSource { return s.desc }
+
+type readerSourceTestReader struct {
+	logger.Writer
+	id string
+}
+
+func (*readerSourceTestReader) Close() {}
+func (r *readerSourceTestReader) APIReaderDescribe() *defs.APIPathReader {
+	return &defs.APIPathReader{Type: defs.APIPathReaderTypeSRTConn, ID: r.id}
+}
+
+func readerSourceRegister(pa *path, reader defs.Reader) defs.PathAddReaderRes {
+	ch := make(chan defs.PathAddReaderRes, 1)
+	pa.addReaderPost(defs.PathAddReaderReq{Author: reader, Res: ch})
+	return <-ch
+}
+
+func TestPathReaderSourceRegistration(t *testing.T) {
+	firstID, secondID := uuid.NewString(), uuid.NewString()
+	selected := &readerSourceTestSource{Writer: test.NilLogger, desc: &defs.APIPathSource{Type: defs.APIPathSourceTypeSRTConn, ID: firstID}}
+	firstStream, secondStream := &stream.Stream{}, &stream.Stream{}
+	pa := &path{conf: &conf.Path{}, source: selected, stream: firstStream, readers: make(map[defs.Reader]struct{})}
+	firstReader := &readerSourceTestReader{Writer: test.NilLogger, id: uuid.NewString()}
+	first := readerSourceRegister(pa, firstReader)
+	require.NoError(t, first.Err)
+	require.Same(t, firstStream, first.Stream)
+	require.Equal(t, selected.desc, first.Source)
+	require.NotSame(t, selected.desc, first.Source)
+	duplicate := readerSourceRegister(pa, firstReader)
+	require.NoError(t, duplicate.Err)
+	require.Same(t, firstStream, duplicate.Stream)
+	require.Equal(t, first.Source, duplicate.Source)
+	require.NotSame(t, first.Source, duplicate.Source)
+	require.Len(t, pa.readers, 1)
+
+	// Replacing the active publication cannot change an already returned registration.
+	selected.desc.ID = secondID
+	pa.source = &readerSourceTestSource{Writer: test.NilLogger, desc: &defs.APIPathSource{Type: defs.APIPathSourceTypeSRTConn, ID: secondID}}
+	pa.stream = secondStream
+	second := readerSourceRegister(pa, &readerSourceTestReader{Writer: test.NilLogger, id: uuid.NewString()})
+	require.NoError(t, second.Err)
+	require.Same(t, secondStream, second.Stream)
+	require.Equal(t, secondID, second.Source.ID)
+	require.Equal(t, firstID, first.Source.ID)
+	require.Equal(t, firstID, duplicate.Source.ID)
+	second.Source.ID = "caller mutation"
+	require.Equal(t, secondID, pa.source.APISourceDescribe().ID)
+}
+
+func TestPathReaderSourceSuppression(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		always bool
+		source defs.Source
+	}{
+		{name: "always available", always: true, source: &readerSourceTestSource{desc: &defs.APIPathSource{Type: defs.APIPathSourceTypeSRTConn, ID: uuid.NewString()}}},
+		{name: "no source"},
+		{name: "nil descriptor", source: &readerSourceTestSource{}},
+		{name: "non SRT", source: &readerSourceTestSource{desc: &defs.APIPathSource{Type: defs.APIPathSourceTypeRTMPConn, ID: uuid.NewString()}}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			strm := &stream.Stream{}
+			pa := &path{conf: &conf.Path{AlwaysAvailable: tc.always}, source: tc.source, stream: strm, readers: make(map[defs.Reader]struct{})}
+			reader := &readerSourceTestReader{id: uuid.NewString()}
+			for range 2 {
+				res := readerSourceRegister(pa, reader)
+				require.NoError(t, res.Err)
+				require.Same(t, strm, res.Stream)
+				require.Nil(t, res.Source)
+			}
+		})
+	}
+}
+
+func TestPathReaderSourceRegistrationError(t *testing.T) {
+	pa := &path{conf: &conf.Path{MaxReaders: 1}, source: &readerSourceTestSource{desc: &defs.APIPathSource{Type: defs.APIPathSourceTypeSRTConn, ID: uuid.NewString()}}, stream: &stream.Stream{}, readers: make(map[defs.Reader]struct{})}
+	reader := &readerSourceTestReader{id: uuid.NewString()}
+	require.NoError(t, readerSourceRegister(pa, reader).Err)
+	res := readerSourceRegister(pa, &readerSourceTestReader{id: uuid.NewString()})
+	require.EqualError(t, res.Err, "maximum reader count reached")
+	require.Nil(t, res.Stream)
+	require.Nil(t, res.Source)
+	require.NoError(t, readerSourceRegister(pa, reader).Err, "duplicate registration must still succeed at the reader limit")
+}
diff --git a/internal/protocols/mpegts/to_stream_clock_origin_test.go b/internal/protocols/mpegts/to_stream_clock_origin_test.go
new file mode 100644
index 0000000..7bb785b
--- /dev/null
+++ b/internal/protocols/mpegts/to_stream_clock_origin_test.go
@@ -0,0 +1,138 @@
+package mpegts
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"testing"
+	"time"
+
+	"github.com/bluenviron/gortsplib/v5/pkg/description"
+	"github.com/bluenviron/mediacommon/v2/pkg/codecs/mpeg4audio"
+	mcmpegts "github.com/bluenviron/mediacommon/v2/pkg/formats/mpegts"
+	"github.com/bluenviron/mediacommon/v2/pkg/formats/mpegts/codecs"
+	"github.com/stretchr/testify/require"
+
+	"github.com/bluenviron/mediamtx/internal/stream"
+	"github.com/bluenviron/mediamtx/internal/test"
+	"github.com/bluenviron/mediamtx/internal/unit"
+)
+
+// Exercise real TS demux callbacks and delivered stream units, using the unmodified
+// mediacommon decoder as the oracle, including audio selecting the shared origin.
+func TestToStreamClockOrigin(t *testing.T) {
+	for _, origin := range []int64{0, 9000, (1 << 33) - 2000} {
+		for _, audioFirst := range []bool{false, true} {
+			for _, observed := range []bool{false, true} {
+				t.Run(fmt.Sprintf("origin_%d/audio_first_%v/observed_%v", origin, audioFirst, observed), func(t *testing.T) {
+					var buf bytes.Buffer
+					video := &mcmpegts.Track{Codec: &codecs.H264{}}
+					audio := &mcmpegts.Track{Codec: &codecs.MPEG4Audio{Config: mpeg4audio.AudioSpecificConfig{
+						Type: 2, SampleRate: 48000, ChannelConfig: 2,
+					}}}
+					w := &mcmpegts.Writer{W: &buf, Tracks: []*mcmpegts.Track{video, audio}}
+					require.NoError(t, w.Initialize())
+					_, err := w.WriteTables()
+					require.NoError(t, err)
+					// Backward steps and wrap are intentional. The first callback is not the minimum PTS.
+					pts := []int64{origin, (origin + 3000) & ((1 << 33) - 1), (origin + 1000) & ((1 << 33) - 1),
+						(origin + 6000) & ((1 << 33) - 1), (origin + 9000) & ((1 << 33) - 1)}
+					type sample struct {
+						audio bool
+						pts   int64
+					}
+					var expected []sample
+					for i, p := range pts {
+						isAudio := (i%2 == 0) == audioFirst
+						if isAudio {
+							require.NoError(t, w.WriteMPEG4Audio(audio, p, [][]byte{{1, 2, 3, 4}}))
+						} else {
+							require.NoError(t, w.WriteH264(video, p, p, [][]byte{test.FormatH264.SPS, test.FormatH264.PPS, {5, byte(i)}}))
+						}
+					}
+					// Video PES delivery can lag audio. Observe the actual callback order
+					// independently instead of assuming writer order or the lowest PTS.
+					oracle := &mcmpegts.TimeDecoder{}
+					oracle.Initialize()
+					raw := &EnhancedReader{R: bytes.NewReader(buf.Bytes())}
+					require.NoError(t, raw.Initialize())
+					var firstPTS int64
+					observe := func(p int64, isAudio bool) {
+						if len(expected) == 0 {
+							firstPTS = p
+						}
+						d := oracle.Decode(p)
+						if isAudio {
+							d = multiplyAndDivide(d, 48000, 90000)
+						}
+						expected = append(expected, sample{isAudio, d})
+					}
+					for _, track := range raw.Tracks() {
+						switch track.Codec.(type) {
+						case *codecs.H264:
+							raw.OnDataH264(track, func(p, _ int64, _ [][]byte) error { observe(p, false); return nil })
+						case *codecs.MPEG4Audio:
+							raw.OnDataMPEG4Audio(track, func(p int64, _ [][]byte) error { observe(p, true); return nil })
+						}
+					}
+					for {
+						err = raw.Read()
+						if err != nil {
+							require.ErrorIs(t, err, io.EOF)
+							break
+						}
+					}
+					require.NotEmpty(t, expected)
+					if audioFirst {
+						require.Equal(t, origin, firstPTS)
+					}
+					r := &EnhancedReader{R: bytes.NewReader(buf.Bytes())}
+					require.NoError(t, r.Initialize())
+					var sub *stream.SubStream
+					var origins []int64
+					var medias []*description.Media
+					if observed {
+						medias, err = ToStreamWithClockOrigin(r, &sub, test.NilLogger, func(p int64) { origins = append(origins, p) })
+					} else {
+						medias, err = ToStream(r, &sub, test.NilLogger)
+					}
+					require.NoError(t, err)
+					require.Empty(t, origins, "registration must not observe a timestamp")
+					s := &stream.Stream{OrigDesc: &description.Session{Medias: medias}, WriteQueueSize: 512, RTPMaxPayloadSize: 1450, Parent: test.NilLogger}
+					require.NoError(t, s.Initialize())
+					defer s.Close()
+					sub = &stream.SubStream{Stream: s}
+					require.NoError(t, sub.Initialize())
+					received := make(chan sample, 32)
+					reader := &stream.Reader{Parent: test.NilLogger}
+					for _, media := range medias {
+						isAudio := media.Type == description.MediaTypeAudio
+						reader.OnData(media, media.Formats[0], func(u *unit.Unit) error { received <- sample{isAudio, u.PTS}; return nil })
+					}
+					s.AddReader(reader)
+					defer s.RemoveReader(reader)
+					for {
+						err = r.Read()
+						if err != nil {
+							require.ErrorIs(t, err, io.EOF)
+							break
+						}
+					}
+					if observed {
+						require.Equal(t, []int64{firstPTS}, origins)
+					} else {
+						require.Empty(t, origins)
+					}
+					for _, want := range expected {
+						select {
+						case got := <-received:
+							require.Equal(t, want, got)
+						case <-time.After(time.Second):
+							t.Fatal("missing stream unit")
+						}
+					}
+				})
+			}
+		}
+	}
+}
diff --git a/internal/servers/srt/conn_clock_origin_test.go b/internal/servers/srt/conn_clock_origin_test.go
new file mode 100644
index 0000000..190fad2
--- /dev/null
+++ b/internal/servers/srt/conn_clock_origin_test.go
@@ -0,0 +1,175 @@
+package srt
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/bluenviron/mediacommon/v2/pkg/codecs/mpeg4audio"
+	"github.com/bluenviron/mediacommon/v2/pkg/formats/mpegts"
+	"github.com/bluenviron/mediacommon/v2/pkg/formats/mpegts/codecs"
+	gosrt "github.com/datarhei/gosrt"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+
+	"github.com/bluenviron/mediamtx/internal/conf"
+	"github.com/bluenviron/mediamtx/internal/defs"
+	"github.com/bluenviron/mediamtx/internal/stream"
+	"github.com/bluenviron/mediamtx/internal/test"
+	"github.com/bluenviron/mediamtx/internal/unit"
+)
+
+type clockConnRequest struct{ gosrt.ConnRequest }
+
+func (clockConnRequest) RemoteAddr() net.Addr {
+	return &net.UDPAddr{IP: net.ParseIP("127.0.0.1"), Port: 9999}
+}
+
+type clockConn struct {
+	gosrt.Conn
+	data *bytes.Reader
+	stop chan struct{}
+}
+
+func (c *clockConn) Read(p []byte) (int, error) {
+	n, err := c.data.Read(p)
+	if err == io.EOF {
+		<-c.stop
+	}
+	return n, err
+}
+func (*clockConn) SetReadDeadline(time.Time) error { return nil }
+func (*clockConn) Stats(*gosrt.Statistics)         {}
+
+type clockPath struct {
+	dummyPath
+	removed chan struct{}
+}
+
+func (p *clockPath) RemovePublisher(defs.PathRemovePublisherReq) { close(p.removed) }
+
+func clockJSON(t *testing.T, c *conn) map[string]any {
+	t.Helper()
+	b, err := json.Marshal(c.apiItem())
+	require.NoError(t, err)
+	var item map[string]any
+	require.NoError(t, json.Unmarshal(b, &item))
+	return item
+}
+
+func TestConnClockOriginLifecycle(t *testing.T) {
+	for _, always := range []bool{false, true} {
+		for _, origin := range []int64{0, 9000, (1 << 33) - 2000} {
+			t.Run(fmt.Sprintf("always_%v/origin_%d", always, origin), func(t *testing.T) {
+				var buf bytes.Buffer
+				audio := &mpegts.Track{Codec: &codecs.MPEG4Audio{Config: mpeg4audio.AudioSpecificConfig{Type: 2, SampleRate: 48000, ChannelConfig: 2}}}
+				video := &mpegts.Track{Codec: &codecs.H264{}}
+				w := &mpegts.Writer{W: &buf, Tracks: []*mpegts.Track{video, audio}}
+				require.NoError(t, w.Initialize())
+				_, err := w.WriteTables()
+				require.NoError(t, err)
+				require.NoError(t, w.WriteMPEG4Audio(audio, origin, [][]byte{{1, 2, 3, 4}}))
+				require.NoError(t, w.WriteH264(video, (origin+3000)&((1<<33)-1), (origin+3000)&((1<<33)-1), [][]byte{test.FormatH264.SPS, test.FormatH264.PPS, {5, 1}}))
+				require.NoError(t, w.WriteMPEG4Audio(audio, (origin+6000)&((1<<33)-1), [][]byte{{1, 2, 3, 4}}))
+				transport := &clockConn{data: bytes.NewReader(buf.Bytes()), stop: make(chan struct{})}
+				defer func() {
+					select {
+					case <-transport.stop:
+					default:
+						close(transport.stop)
+					}
+				}()
+				path := &clockPath{removed: make(chan struct{})}
+				pathConf := &conf.Path{AlwaysAvailable: always}
+				added := make(chan struct{})
+				proceed := make(chan struct{})
+				delivered := make(chan struct{}, 10)
+				var strm *stream.Stream
+				var reader *stream.Reader
+				c := &conn{uuid: uuid.New(), connReq: clockConnRequest{}, state: defs.APISRTConnStateIdle,
+					readTimeout: conf.Duration(time.Second), parent: &Server{Parent: test.NilLogger}}
+				c.pathManager = &test.PathManager{AddPublisherImpl: func(req defs.PathAddPublisherReq) (*defs.PathAddPublisherRes, error) {
+					require.Same(t, pathConf, req.ConfToCompare)
+					strm = &stream.Stream{OrigDesc: req.Desc, WriteQueueSize: 512, RTPMaxPayloadSize: 1450, Parent: test.NilLogger}
+					require.NoError(t, strm.Initialize())
+					sub := &stream.SubStream{Stream: strm}
+					require.NoError(t, sub.Initialize())
+					reader = &stream.Reader{Parent: test.NilLogger}
+					for _, media := range req.Desc.Medias {
+						reader.OnData(media, media.Formats[0], func(*unit.Unit) error { delivered <- struct{}{}; return nil })
+					}
+					strm.AddReader(reader)
+					close(added)
+					<-proceed
+					return &defs.PathAddPublisherRes{Path: path, SubStream: sub}, nil
+				}}
+				done := make(chan error, 1)
+				go func() { done <- c.runPublishReader(transport, &streamID{path: "clock-test"}, pathConf) }()
+				select {
+				case <-added:
+				case <-time.After(time.Second):
+					t.Fatal("publisher not added")
+				}
+				defer func() { strm.RemoveReader(reader); strm.Close() }()
+				require.NotContains(t, clockJSON(t, c), "scorebugTransportClock", "no decoder callback yet")
+				close(proceed)
+				select {
+				case <-delivered:
+				case <-time.After(time.Second):
+					t.Fatal("missing callback")
+				}
+				item := clockJSON(t, c)
+				if always {
+					require.NotContains(t, item, "scorebugTransportClock")
+				} else {
+					require.Equal(t, map[string]any{"convention": "mpegts-ingress-origin-90k-v1", "originPTS": fmt.Sprint(origin)}, item["scorebugTransportClock"])
+					require.Equal(t, c.uuid.String(), item["id"])
+					require.Equal(t, "publish", item["state"])
+					require.Equal(t, "clock-test", item["path"])
+					// Returned API objects are independent snapshots, even if a caller mutates one.
+					snapshot := c.apiItem()
+					snapshot.ScorebugTransportClock.OriginPTS = "mutated"
+					require.Equal(t, fmt.Sprint(origin), c.apiItem().ScorebugTransportClock.OriginPTS)
+					for _, state := range []defs.APISRTConnState{defs.APISRTConnStateRead, defs.APISRTConnStateIdle} {
+						c.mutex.Lock()
+						c.state = state
+						c.mutex.Unlock()
+						require.NotContains(t, clockJSON(t, c), "scorebugTransportClock")
+					}
+					c.mutex.Lock()
+					c.state = defs.APISRTConnStatePublish
+					c.mutex.Unlock()
+					other := &conn{uuid: uuid.New(), connReq: clockConnRequest{}, state: defs.APISRTConnStatePublish, pathName: "clock-test"}
+					require.NotContains(t, clockJSON(t, other), "scorebugTransportClock", "new publication must not inherit origin")
+				}
+				// Concurrent snapshots race with teardown and mutate only their own copy.
+				var wg sync.WaitGroup
+				for range 8 {
+					wg.Go(func() {
+						for range 100 {
+							v := c.apiItem()
+							if v.ScorebugTransportClock != nil {
+								v.ScorebugTransportClock.OriginPTS = "local"
+							}
+						}
+					})
+				}
+				close(transport.stop)
+				select {
+				case err := <-done:
+					require.ErrorIs(t, err, io.EOF)
+				case <-time.After(time.Second):
+					t.Fatal("reader did not exit")
+				}
+				wg.Wait()
+				<-path.removed
+				require.NotContains(t, clockJSON(t, c), "scorebugTransportClock", "reader teardown clears origin")
+			})
+		}
+	}
+}
diff --git a/internal/servers/srt/conn_reader_source_test.go b/internal/servers/srt/conn_reader_source_test.go
new file mode 100644
index 0000000..8115d48
--- /dev/null
+++ b/internal/servers/srt/conn_reader_source_test.go
@@ -0,0 +1,197 @@
+package srt
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/bluenviron/gortsplib/v5/pkg/description"
+	"github.com/bluenviron/gortsplib/v5/pkg/format"
+	gosrt "github.com/datarhei/gosrt"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+
+	"github.com/bluenviron/mediamtx/internal/conf"
+	"github.com/bluenviron/mediamtx/internal/defs"
+	"github.com/bluenviron/mediamtx/internal/stream"
+	"github.com/bluenviron/mediamtx/internal/test"
+)
+
+type readerSourceRequest struct {
+	gosrt.ConnRequest
+	transport gosrt.Conn
+	acceptErr error
+}
+
+func (*readerSourceRequest) RemoteAddr() net.Addr {
+	return &net.UDPAddr{IP: net.ParseIP("127.0.0.1"), Port: 9999}
+}
+func (r *readerSourceRequest) Accept() (gosrt.Conn, error) { return r.transport, r.acceptErr }
+func (*readerSourceRequest) Reject(gosrt.RejectionReason)  {}
+func (*readerSourceRequest) IsEncrypted() bool             { return false }
+
+type readerSourceTransport struct {
+	gosrt.Conn
+	beforeAttach chan struct{}
+	proceed      chan struct{}
+}
+
+func (s *readerSourceTransport) SetReadDeadline(time.Time) error {
+	if s.beforeAttach != nil {
+		close(s.beforeAttach)
+		<-s.proceed
+	}
+	return nil
+}
+func (*readerSourceTransport) Stats(*gosrt.Statistics) {}
+func (*readerSourceTransport) Close() error            { return nil }
+
+type readerSourcePath struct {
+	dummyPath
+	conf    *conf.Path
+	removed chan struct{}
+}
+
+func (p *readerSourcePath) SafeConf() *conf.Path                  { return p.conf }
+func (p *readerSourcePath) RemoveReader(defs.PathRemoveReaderReq) { close(p.removed) }
+
+func TestConnReaderSourceLifecycle(t *testing.T) {
+	publisherID := uuid.NewString()
+	for _, tc := range []struct {
+		name   string
+		source *defs.APIPathSource
+		valid  bool
+	}{
+		{"canonical", &defs.APIPathSource{Type: defs.APIPathSourceTypeSRTConn, ID: publisherID}, true},
+		{"canonical zero", &defs.APIPathSource{Type: defs.APIPathSourceTypeSRTConn, ID: uuid.Nil.String()}, true},
+		{"absent", nil, false},
+		{"non SRT", &defs.APIPathSource{Type: defs.APIPathSourceTypeRTMPConn, ID: publisherID}, false},
+		{"empty ID", &defs.APIPathSource{Type: defs.APIPathSourceTypeSRTConn}, false},
+		{"malformed ID", &defs.APIPathSource{Type: defs.APIPathSourceTypeSRTConn, ID: "publisher"}, false},
+		{"uppercase ID", &defs.APIPathSource{Type: defs.APIPathSourceTypeSRTConn, ID: strings.ToUpper("abcdefab-cdef-abcd-efab-cdefabcdefab")}, false},
+		{"compact ID", &defs.APIPathSource{Type: defs.APIPathSourceTypeSRTConn, ID: strings.ReplaceAll(publisherID, "-", "")}, false},
+		{"URN ID", &defs.APIPathSource{Type: defs.APIPathSourceTypeSRTConn, ID: "urn:uuid:" + publisherID}, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			strm := &stream.Stream{OrigDesc: &description.Session{Medias: []*description.Media{{Type: description.MediaTypeVideo, Formats: []format.Format{test.FormatH264}}}}, WriteQueueSize: 512, RTPMaxPayloadSize: 1450, Parent: test.NilLogger}
+			require.NoError(t, strm.Initialize())
+			defer strm.Close()
+			transport := &readerSourceTransport{beforeAttach: make(chan struct{}), proceed: make(chan struct{})}
+			path := &readerSourcePath{conf: &conf.Path{}, removed: make(chan struct{})}
+			res := &defs.PathAddReaderRes{Path: path, Stream: strm, Source: tc.source}
+			c := &conn{ctx: ctx, uuid: uuid.New(), connReq: &readerSourceRequest{transport: transport}, state: defs.APISRTConnStateIdle, udpMaxPayloadSize: 1472, parent: &Server{Parent: test.NilLogger}}
+			c.pathManager = &test.PathManager{AddReaderImpl: func(req defs.PathAddReaderReq) (*defs.PathAddReaderRes, error) {
+				require.Same(t, c, req.Author)
+				require.Equal(t, "relay-test", req.AccessRequest.Name)
+				require.NotContains(t, clockJSON(t, c), "scorebugReaderSource", "path registration alone is insufficient")
+				return res, nil
+			}}
+			require.NotContains(t, clockJSON(t, c), "scorebugReaderSource")
+			done := make(chan error, 1)
+			stopped := make(chan struct{})
+			go func() {
+				defer close(stopped)
+				done <- c.runRead(&streamID{path: "relay-test"})
+			}()
+			defer func() {
+				cancel()
+				select {
+				case <-transport.proceed:
+				default:
+					close(transport.proceed)
+				}
+				<-stopped
+			}()
+			select {
+			case <-transport.beforeAttach:
+			case <-time.After(time.Second):
+				t.Fatal("did not reach pre-attachment boundary")
+			}
+			require.Equal(t, defs.APISRTConnStateRead, c.apiItem().State)
+			require.NotContains(t, clockJSON(t, c), "scorebugReaderSource", "read state precedes stream attachment")
+			close(transport.proceed)
+			require.Eventually(t, func() bool { c.mutex.RLock(); defer c.mutex.RUnlock(); return c.reader != nil }, time.Second, time.Millisecond)
+			strm.WaitForReaders() // Real Stream.AddReader was executed.
+			if tc.valid {
+				want := *tc.source
+				require.Equal(t, map[string]any{"type": "srtConn", "id": want.ID}, clockJSON(t, c)["scorebugReaderSource"])
+				require.NotContains(t, clockJSON(t, c), "scorebugTransportClock", "reader must never expose a publisher clock")
+				tc.source.ID = uuid.NewString()
+				require.Equal(t, want.ID, c.apiItem().ScorebugReaderSource.ID, "source descriptor is copied at attachment")
+				snapshot := c.apiItem()
+				snapshot.ScorebugReaderSource.ID = "caller mutation"
+				require.Equal(t, want.ID, c.apiItem().ScorebugReaderSource.ID)
+				for _, state := range []defs.APISRTConnState{defs.APISRTConnStatePublish, defs.APISRTConnStateIdle} {
+					c.mutex.Lock()
+					c.state = state
+					c.mutex.Unlock()
+					require.NotContains(t, clockJSON(t, c), "scorebugReaderSource")
+				}
+				c.mutex.Lock()
+				c.state = defs.APISRTConnStateRead
+				c.mutex.Unlock()
+			} else {
+				require.NotContains(t, clockJSON(t, c), "scorebugReaderSource")
+			}
+			var wg sync.WaitGroup
+			for range 8 {
+				wg.Go(func() {
+					for range 200 {
+						item := c.apiItem()
+						if item.ScorebugReaderSource != nil {
+							item.ScorebugReaderSource.ID = "local"
+						}
+					}
+				})
+			}
+			cancel()
+			select {
+			case err := <-done:
+				require.EqualError(t, err, "terminated")
+			case <-time.After(time.Second):
+				t.Fatal("read did not exit")
+			}
+			wg.Wait()
+			<-path.removed
+			require.NotContains(t, clockJSON(t, c), "scorebugReaderSource", "read exit clears the attachment")
+		})
+	}
+}
+
+func TestConnReaderSourceFailedStartup(t *testing.T) {
+	for _, phase := range []string{"registration", "passphrase", "accept", "format"} {
+		t.Run(phase, func(t *testing.T) {
+			path := &readerSourcePath{conf: &conf.Path{}, removed: make(chan struct{})}
+			transport := &readerSourceTransport{}
+			request := &readerSourceRequest{transport: transport}
+			if phase == "passphrase" {
+				path.conf.SRTReadPassphrase = "reader-password"
+			}
+			if phase == "accept" {
+				request.acceptErr = fmt.Errorf("accept failed")
+			}
+			c := &conn{ctx: context.Background(), uuid: uuid.New(), connReq: request, state: defs.APISRTConnStateIdle, udpMaxPayloadSize: 1472, parent: &Server{Parent: test.NilLogger}}
+			c.pathManager = &test.PathManager{AddReaderImpl: func(defs.PathAddReaderReq) (*defs.PathAddReaderRes, error) {
+				if phase == "registration" {
+					return nil, fmt.Errorf("registration failed")
+				}
+				return &defs.PathAddReaderRes{Path: path, Stream: &stream.Stream{OrigDesc: &description.Session{}}, Source: &defs.APIPathSource{Type: defs.APIPathSourceTypeSRTConn, ID: uuid.NewString()}}, nil
+			}}
+			// Even an unsuccessful read attempt must clear any previous cached descriptor.
+			c.readerSource = &defs.APIPathSource{Type: defs.APIPathSourceTypeSRTConn, ID: uuid.NewString()}
+			require.Error(t, c.runRead(&streamID{path: "relay-test"}))
+			require.Nil(t, c.readerSource)
+			require.NotContains(t, clockJSON(t, c), "scorebugReaderSource")
+			require.Nil(t, c.reader)
+			if phase != "registration" {
+				<-path.removed
+			}
+		})
+	}
+}
