+	mcmpegts "github.com/bluenviron/mediacommon/v2/pkg/formats/mpegts"
+	"github.com/bluenviron/mediacommon/v2/pkg/formats/mpegts/codecs"
+	"github.com/bluenviron/mediamtx/internal/logger"
+	"github.com/bluenviron/mediamtx/internal/stream"
+	"github.com/bluenviron/mediamtx/internal/test"
+	"github.com/bluenviron/mediamtx/internal/unit"
+	srt "github.com/datarhei/gosrt"
+	"github.com/stretchr/testify/require"
+)
+
+type recoveryConn struct{ srt.Conn }
+
+func (*recoveryConn) SetWriteDeadline(time.Time) error { return nil }
+
+type recoveryWriter struct {
+	mutex   sync.Mutex
+	data    bytes.Buffer
+	writes  int
+	changed chan struct{}
+}
+
+func (w *recoveryWriter) Write(p []byte) (int, error) {
+	w.mutex.Lock()
+	n, err := w.data.Write(p)
+	w.writes++
+	w.mutex.Unlock()
+	select {
+	case w.changed <- struct{}{}:
+	default:
+	}
+	return n, err
+}
+func (w *recoveryWriter) snapshot() ([]byte, int) {
+	w.mutex.Lock()
+	defer w.mutex.Unlock()
+	return bytes.Clone(w.data.Bytes()), w.writes
+}
+
+func TestFromStreamH264RecoversSameReaderAndPreservesAudio(t *testing.T) {
+	vf := &format.H264{PayloadTyp: 96, SPS: bytes.Clone(recoverySPS), PPS: []byte{0x68, 0xee, 0x3c, 0x80}, PacketizationMode: 1}
+	af := test.FormatMPEG4Audio
+	vm := &description.Media{Type: description.MediaTypeVideo, Formats: []format.Format{vf}}
+	am := &description.Media{Type: description.MediaTypeAudio, Formats: []format.Format{af}}
+	desc := &description.Session{Medias: []*description.Media{vm, am}}
+	var logsMu sync.Mutex
+	var logs []string
+	log := test.Logger(func(_ logger.Level, message string, args ...any) {
+		logsMu.Lock()
+		defer logsMu.Unlock()
+		logs = append(logs, fmt.Sprintf(message, args...))
+	})
+	st := &stream.Stream{OrigDesc: desc, WriteQueueSize: 512, RTPMaxPayloadSize: 1450, Parent: log}
+	require.NoError(t, st.Initialize())
+	defer st.Close()
+	sub := &stream.SubStream{Stream: st}
+	require.NoError(t, sub.Initialize())
+	writer := &recoveryWriter{changed: make(chan struct{}, 1)}
+	reader := &stream.Reader{Parent: log}
+	require.NoError(t, FromStream(desc, reader, bufio.NewWriter(writer), &recoveryConn{}, time.Second))
+	st.AddReader(reader)
+	defer st.RemoveReader(reader)
+	video := func(n int, idr bool, pts int64) {
+		sub.WriteUnit(vm, vf, &unit.Unit{PTS: pts, NTP: time.Now(), Payload: unit.PayloadH264(recoveryAU(t, n, idr))})
+	}
+	audio := func(n int) {
+		sub.WriteUnit(am, af, &unit.Unit{PTS: int64(n) * 4410, NTP: time.Now(), Payload: unit.PayloadMPEG4Audio{{byte(n), 1, 2, 3}}})
+	}
+	video(2, false, 0) // Normal late-reader acquisition must not be diagnosed as lost timing.
+	for n := 0; n < 7; n++ {
+		video(n, n == 0, int64(n)*3000)
+		audio(n)
+	}
+	video(22, false, 66000)
+	audio(7)
+	video(23, false, 69000)
+	audio(8)
+	video(0, true, 90000)
+	audio(9)
+	video(1, false, 93000)
+	audio(10)
+	timer := time.NewTimer(3 * time.Second)
+	defer timer.Stop()
+	var encoded []byte
+	for {
+		data, n := writer.snapshot()
+		if n >= 20 {
+			encoded = data
+			break
+		}
+		select {
+		case err := <-reader.Error():
+			t.Fatalf("reader ended before recovery: %v", err)
+		case <-writer.changed:
+		case <-timer.C:
+			t.Fatal("writer did not emit recovered video and all audio")
+		}
+	}
+	select {
+	case err := <-reader.Error():
+		t.Fatalf("reader unexpectedly ended: %v", err)
+	default:
+	}
+	logsMu.Lock()
+	messages := append([]string(nil), logs...)
+	logsMu.Unlock()
+	require.Equal(t, []string{"H264 timing lost; waiting for random access", "H264 timing recovered after discarding 2 access units"}, messages)
+	var gotVideo, gotAudio []int64
+	decoded := &mcmpegts.Reader{R: bytes.NewReader(encoded)}
+	require.NoError(t, decoded.Initialize())
+	for _, track := range decoded.Tracks() {
+		switch track.Codec.(type) {
+		case *codecs.H264:
+			decoded.OnDataH264(track, func(pts, dts int64, _ [][]byte) error {
+				require.Equal(t, pts, dts)
+				gotVideo = append(gotVideo, pts)
+				return nil
+			})
+		case *codecs.MPEG4Audio:
+			decoded.OnDataMPEG4Audio(track, func(pts int64, aus [][]byte) error {
+				require.Equal(t, byte(len(gotAudio)), aus[0][0])
+				gotAudio = append(gotAudio, pts)
+				return nil
+			})
+		}
+	}
+	for {
+		err := decoded.Read()
+		if err == io.EOF {
+			break
+		}
+		require.NoError(t, err)
+	}
+	require.Equal(t, []int64{0, 3000, 6000, 9000, 12000, 15000, 18000, 90000, 93000}, gotVideo)
+	require.Equal(t, []int64{0, 9000, 18000, 27000, 36000, 45000, 54000, 63000, 72000, 81000, 90000}, gotAudio)
+}
