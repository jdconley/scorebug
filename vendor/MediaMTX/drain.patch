--- /dev/null
+++ b/internal/core/scorebug_drain_test.go
@@ -0,0 +1,56 @@
+package core
+
+import (
+	"encoding/json"
+	"testing"
+	"time"
+
+	"github.com/bluenviron/gortsplib/v5/pkg/description"
+	"github.com/bluenviron/mediamtx/internal/conf"
+	"github.com/bluenviron/mediamtx/internal/defs"
+	"github.com/bluenviron/mediamtx/internal/test"
+	"github.com/stretchr/testify/require"
+)
+
+func TestScorebugDrain(t *testing.T) {
+	original := &conf.Path{Name: "drain", Source: "publisher"}
+	retired := original.Clone()
+	require.NoError(t, json.Unmarshal([]byte(`{"scorebugDrain":true}`), retired))
+	data, err := json.Marshal(retired)
+	require.NoError(t, err)
+	require.Contains(t, string(data), `"scorebugDrain":true`)
+	require.True(t, pathConfCanBeUpdated(original, retired))
+	pm := &pathManager{authManager: test.NilAuthManager,
+		pathConfs: map[string]*conf.Path{"drain": original}, parent: test.NilLogger}
+	pm.initialize()
+	defer pm.close()
+	access := defs.PathAccessRequest{Name: "drain"}
+	publisher, err := pm.AddPublisher(defs.PathAddPublisherReq{
+		Author: &dummyPublisher{}, Desc: &description.Session{}, AccessRequest: access})
+	require.NoError(t, err)
+	reader, err := pm.AddReader(defs.PathAddReaderReq{Author: &dummyReader{}, AccessRequest: access})
+	require.NoError(t, err)
+	pa := publisher.Path.(*path)
+	pm.ReloadPathConfs(map[string]*conf.Path{"drain": retired})
+	_, err = pm.FindPathConf(defs.PathFindPathConfReq{AccessRequest: access})
+	require.EqualError(t, err, "path is draining")
+	require.NoError(t, pa.ctx.Err(), "accepted source must survive revocation")
+	require.Same(t, reader.Path, publisher.Path)
+	_, err = pm.AddReader(defs.PathAddReaderReq{Author: &dummyReader{}, AccessRequest: access})
+	require.EqualError(t, err, "path is draining")
+	_, err = pm.AddPublisher(defs.PathAddPublisherReq{Author: &dummyPublisher{}, AccessRequest: access})
+	require.EqualError(t, err, "path is draining")
+	// Requests that passed the manager before revocation must also be rejected.
+	pa.pendingRequests.Add(1)
+	_, err = pa.addReader(defs.PathAddReaderReq{Author: &dummyReader{}, AccessRequest: access, Res: make(chan defs.PathAddReaderRes)})
+	require.EqualError(t, err, "path is draining")
+	pa.pendingRequests.Add(1)
+	_, err = pa.addPublisher(defs.PathAddPublisherReq{Author: &dummyPublisher{}, AccessRequest: access, Res: make(chan defs.PathAddPublisherRes)})
+	require.EqualError(t, err, "path is draining")
+	// Even if the control plane disappears, the old accepted source is bounded.
+	select {
+	case <-pa.ctx.Done():
+	case <-time.After(9 * time.Second):
+		t.Fatal("drain did not expire")
+	}
+}
