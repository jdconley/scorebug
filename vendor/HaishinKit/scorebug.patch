+              sampled <= at, at - sampled <= 0.1, statistics.msRTT.isFinite,
+              (0...50).contains(statistics.msRTT), (0...50).contains(statistics.msSndBuf),
+              statistics.pktSndDropTotal >= 0 else { throw SRTBandwidthProbeError.unavailableStatistics }
