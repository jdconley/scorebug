# The match container receives these from apps/control-plane/src/worker/hosted-media.ts.
# These values run the worker process on its own; see README.md.

# The container uses http://api.internal/ (an outbound intercept to the team's Durable Object).
CONTROL_PLANE_URL=http://127.0.0.1:8787/
# Bearer token, at least 16 characters. The container's is a fixed placeholder.
HOME_TOKEN=local-worker-token-not-a-secret
WORKER_ID=match
OUTPUT_ID=youtube

# 240p30, 360p30, 540p30, 720p30, 1080p30 (default) or 2160p30.
VIDEO_PROFILE=1080p30

# Tuning the container sets.
SCORE_DELAY_MS=1100
INPUT_PROBE=fast
INPUT_READ_TIMEOUT_MS=4000
OUTPUT_TIMEOUT_MS=15000
RETRY_MAX_ATTEMPTS=6
RETRY_FREE_AFTER_MS=3000

# The image sets SCORE_DIR; FFMPEG_PATH defaults to ffmpeg on PATH.
SCORE_DIR=/tmp/scorebug
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

LOG_LEVEL=info
