# Local fixture only. Use HTTPS and private credentials for another installation.
CONTROL_PLANE_URL=http://127.0.0.1:18787
HOME_TOKEN=qa-home-token-not-production
# Must match the native broadcast selection.
WORKER_ID=mac
OUTPUT_ID=local-sink

# rtmp (default), record, or rtmp+record. Recording modes require a directory.
OUTPUT_MODE=rtmp
# OUTPUT_RECORDING_DIR=/path/to/scorebug-recordings

# Full destination URL including stream key or authentication parameters.
OUTPUT_URL=rtmp://127.0.0.1:11935/live/fixture?user=qa-worker&pass=qa-output-not-production

# software, videotoolbox (native macOS), or nvenc (NVIDIA host).
ENCODER=software
# auto probes optional encoder-statistics flags; off skips diagnostic probing.
WORKER_PROCESSING=auto
# Delay between status reports. Default 100 ms; valid range 100–5000 ms.
WORKER_REPORT_INTERVAL_MS=100
# Canvas/bitrate preset with a 30fps maximum; lower source rates remain lower.
VIDEO_PROFILE=720p30

# Optional executable paths. Existing installations keep PATH-based defaults.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# The scorebug is rasterized with the bundled Barlow Condensed; FONT_PATH is no longer read.
# macOS examples (do not globally relink Homebrew):
# FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe

# Give each worker process its own score directory; the daemon creates it.
SCORE_DIR=/tmp/scorebug

# Logging
LOG_LEVEL=info
