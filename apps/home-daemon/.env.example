# Where to call the control plane. Use wss:// in prod.
CONTROL_PLANE_WS=ws://localhost:8787/home/ws
HOME_TOKEN=replace-me-home

# Where the YouTube RTMPS endpoint lives. The per-game stream key is sent by control plane.
RTMP_TARGET=rtmps://a.rtmps.youtube.com/live2

# Encoder. NVENC requires NVIDIA Container Toolkit (`--gpus all`). Set false for CPU.
NVENC_ENABLED=true

# Where score text files live for ffmpeg drawtext to read. Must exist; daemon will create it.
SCORE_DIR=/tmp/scorebug

# Logging
LOG_LEVEL=info
