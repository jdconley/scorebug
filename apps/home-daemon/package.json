{
  "name": "@scorebug/home-daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm --filter @scorebug/protocol build && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "echo 'lint: noop'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @scorebug/protocol build && vitest run",
    "test:watch": "pnpm --filter @scorebug/protocol build && vitest"
  },
  "dependencies": {
    "@scorebug/protocol": "workspace:*",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
