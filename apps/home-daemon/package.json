{
  "name": "@scorebug/home-daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm --filter @scorebug/protocol build && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @scorebug/protocol build && vitest run",
    "test:watch": "pnpm --filter @scorebug/protocol build && vitest",
    "render-scorebug": "pnpm --filter @scorebug/protocol build && tsx scripts/render-scorebug.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@scorebug/protocol": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
