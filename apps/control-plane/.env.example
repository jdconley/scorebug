# Bearer tokens — generate with `openssl rand -base64 32`
PHONE_TOKEN=replace-me-phone
HOME_TOKEN=replace-me-home

# Server
PORT=8787
HOST=0.0.0.0

# Durable native match database. Bind-mount its containing directory in containers.
DATABASE_PATH=data/scorebug.sqlite

# Public hostnames (baked into pull URLs handed to home daemon)
INGEST_HOST=ingest.scorebug.live
INGEST_PORT=8890

# CORS — comma-separated origins, or `*` (default) for personal-scale use
CORS_ORIGINS=*

# Logging
LOG_LEVEL=info
