{
  "name": "@scorebug/control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "pnpm --filter @scorebug/protocol build && vitest run",
    "test:watch": "pnpm --filter @scorebug/protocol build && vitest",
    "test:worker": "pnpm --filter @scorebug/protocol build && vitest run --config vitest.worker.config.ts",
    "dev:worker": "pnpm --filter @scorebug/protocol build && wrangler dev"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@scorebug/protocol": "workspace:*",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/node": "^22.9.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  }
}
